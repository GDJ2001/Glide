<Window x:Class="Glide.Windows.UI.Views.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:vm="clr-namespace:Glide.Windows.UI.ViewModels"
        mc:Ignorable="d"
        Title="Glide" Height="680" Width="920"
        MinWidth="820" MinHeight="560"
        WindowStartupLocation="CenterScreen"
        Background="{StaticResource BackgroundBrush}"
        Foreground="{StaticResource TextPrimaryBrush}"
        Icon="../glide.ico">

    <Window.DataContext>
        <vm:MainViewModel />
    </Window.DataContext>

    <Window.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVis" />
    </Window.Resources>

    <Grid>
        <!-- Main Layout -->
        <Grid Margin="24">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <!-- 1. Header & Navigation -->
            <Border Grid.Row="0" Margin="0,0,0,20" Background="{StaticResource SurfaceBrush}"
                    BorderBrush="{StaticResource CardBorderBrush}" BorderThickness="1" CornerRadius="12" Padding="16,12">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>

                    <!-- App Title -->
                    <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
                        <TextBlock Text="Glide" FontSize="20" FontWeight="Bold" Foreground="{StaticResource PrimaryBrush}" VerticalAlignment="Center" />
                        <Border Margin="8,0,0,0" Background="{StaticResource SurfaceHighBrush}" CornerRadius="4" Padding="6,2" VerticalAlignment="Center">
                            <TextBlock Text="Windows Desktop" FontSize="11" FontWeight="SemiBold" Foreground="{StaticResource AccentBrush}" />
                        </Border>
                    </StackPanel>

                    <!-- Navigation Tabs -->
                    <StackPanel Grid.Column="1" Orientation="Horizontal" HorizontalAlignment="Center" VerticalAlignment="Center">
                        <Button Style="{StaticResource SecondaryButtonStyle}" Margin="4,0" Content="Send"
                                Command="{Binding SwitchTabCommand}" CommandParameter="Send" Width="90" />
                        <Button Style="{StaticResource SecondaryButtonStyle}" Margin="4,0" Content="Receive"
                                Command="{Binding SwitchTabCommand}" CommandParameter="Receive" Width="90" />
                        <Button Style="{StaticResource SecondaryButtonStyle}" Margin="4,0" Content="History"
                                Command="{Binding SwitchTabCommand}" CommandParameter="History" Width="90" />
                    </StackPanel>

                    <!-- Quick Action: Downloads Folder -->
                    <Button Grid.Column="2" Style="{StaticResource SecondaryButtonStyle}" Content="📂 Downloads"
                            Command="{Binding OpenDownloadsCommand}" ToolTip="Open received files in Downloads" />
                </Grid>
            </Border>

            <!-- 2. Main Content Tabs -->
            <Grid Grid.Row="1">
                <!-- SEND VIEW -->
                <Grid x:Name="SendView">
                    <Grid.Style>
                        <Style TargetType="Grid">
                            <Setter Property="Visibility" Value="Collapsed" />
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding CurrentTab}" Value="Send">
                                    <Setter Property="Visibility" Value="Visible" />
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </Grid.Style>

                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>

                    <!-- Drag and Drop Target -->
                    <Border Grid.Row="0" Height="140" Margin="0,0,0,16" Background="{StaticResource SurfaceBrush}"
                            BorderBrush="{StaticResource CardBorderBrush}" BorderThickness="2" CornerRadius="12"
                            AllowDrop="True" Drop="DropZone_Drop" DragOver="DropZone_DragOver" Cursor="Hand"
                            MouseLeftButtonUp="DropZone_Click">
                        <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center">
                            <TextBlock Text="📁" FontSize="32" HorizontalAlignment="Center" Margin="0,0,0,8" />
                            <TextBlock Text="Drag and drop files here, or click to browse" FontSize="15" FontWeight="SemiBold"
                                       Foreground="{StaticResource TextPrimaryBrush}" HorizontalAlignment="Center" />
                            <TextBlock Text="Supports multiple files, folders, and high-speed streaming" FontSize="12"
                                       Foreground="{StaticResource TextSecondaryBrush}" HorizontalAlignment="Center" Margin="0,4,0,0" />
                        </StackPanel>
                    </Border>

                    <!-- Selected Files List -->
                    <Border Grid.Row="1" Background="{StaticResource SurfaceBrush}" BorderBrush="{StaticResource CardBorderBrush}"
                            BorderThickness="1" CornerRadius="12" Padding="16">
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="*" />
                            </Grid.RowDefinitions>

                            <DockPanel Grid.Row="0" Margin="0,0,0,10">
                                <TextBlock Text="Queued Files" FontSize="14" FontWeight="SemiBold" Foreground="{StaticResource TextPrimaryBrush}" VerticalAlignment="Center" />
                                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                                    <Button Style="{StaticResource SecondaryButtonStyle}" Content="Clear List" Margin="4,0"
                                            Command="{Binding ClearFilesCommand}" Padding="8,4" />
                                    <Button Style="{StaticResource SecondaryButtonStyle}" Content="+ Add Files" Margin="4,0"
                                            Command="{Binding AddFilesCommand}" Padding="8,4" />
                                </StackPanel>
                            </DockPanel>

                            <ListBox Grid.Row="1" ItemsSource="{Binding SelectedFiles}" Background="Transparent"
                                     BorderThickness="0" ScrollViewer.HorizontalScrollBarVisibility="Disabled">
                                <ListBox.ItemTemplate>
                                    <DataTemplate>
                                        <Border Background="{StaticResource SurfaceHighBrush}" CornerRadius="8"
                                                Padding="12,8" Margin="0,4">
                                            <Grid>
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="*" />
                                                    <ColumnDefinition Width="Auto" />
                                                    <ColumnDefinition Width="Auto" />
                                                    <ColumnDefinition Width="Auto" />
                                                </Grid.ColumnDefinitions>
                                                <TextBlock Grid.Column="0" Text="{Binding Name}" FontWeight="Medium"
                                                           Foreground="{StaticResource TextPrimaryBrush}" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" />
                                                <TextBlock Grid.Column="1" Text="{Binding FormattedSize}" Margin="16,0"
                                                           Foreground="{StaticResource TextSecondaryBrush}" VerticalAlignment="Center" />
                                                <Border Grid.Column="2" Background="{StaticResource PrimaryContainerBrush}"
                                                        CornerRadius="4" Padding="6,2" Margin="0,0,12,0" VerticalAlignment="Center">
                                                    <TextBlock Text="{Binding Status}" FontSize="11" Foreground="{StaticResource TextPrimaryBrush}" />
                                                </Border>
                                                <Button Grid.Column="3" Style="{StaticResource SecondaryButtonStyle}" Content="✕"
                                                        Command="{Binding DataContext.RemoveFileCommand, RelativeSource={RelativeSource AncestorType=ListBox}}"
                                                        CommandParameter="{Binding}" Padding="6,2" FontSize="11" />
                                            </Grid>
                                        </Border>
                                    </DataTemplate>
                                </ListBox.ItemTemplate>
                            </ListBox>
                        </Grid>
                    </Border>

                    <!-- Discovered Peers & Target Bar -->
                    <Border Grid.Row="2" Margin="0,16,0,0" Background="{StaticResource SurfaceBrush}"
                            BorderBrush="{StaticResource CardBorderBrush}" BorderThickness="1" CornerRadius="12" Padding="16,12">
                        <StackPanel>
                            <!-- Header with Scan & Pair via Link Buttons -->
                            <DockPanel Margin="0,0,0,10">
                                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                    <TextBlock Text="🌐 Nearby Glide Peers (mDNS)" FontSize="13" FontWeight="SemiBold"
                                               Foreground="{StaticResource TextPrimaryBrush}" VerticalAlignment="Center" />
                                    <TextBlock Text=" • " Foreground="{StaticResource TextSecondaryBrush}" />
                                    <TextBlock Text="Automatic local discovery" FontSize="11"
                                               Foreground="{StaticResource TextSecondaryBrush}" VerticalAlignment="Center" />
                                </StackPanel>
                                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                                    <Button Style="{StaticResource SecondaryButtonStyle}" Content="🔄 Scan" Margin="4,0"
                                            Command="{Binding RefreshPeersCommand}" Padding="8,3" FontSize="11" />
                                    <Button Style="{StaticResource SecondaryButtonStyle}" Content="🔗 Pair via Link" Margin="4,0"
                                            Command="{Binding ShowPairModalCommand}" Padding="8,3" FontSize="11" />
                                </StackPanel>
                            </DockPanel>

                            <!-- Discovered peers horizontal list -->
                            <ItemsControl ItemsSource="{Binding DiscoveredPeers}" Margin="0,0,0,8">
                                <ItemsControl.ItemsPanel>
                                    <ItemsPanelTemplate>
                                        <WrapPanel Orientation="Horizontal" />
                                    </ItemsPanelTemplate>
                                </ItemsControl.ItemsPanel>
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <Button Style="{StaticResource SecondaryButtonStyle}" Margin="0,0,8,8" Padding="10,6"
                                                Command="{Binding DataContext.SelectPeerCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                                CommandParameter="{Binding}">
                                            <StackPanel Orientation="Horizontal">
                                                <TextBlock Text="{Binding DeviceIcon}" FontSize="14" Margin="0,0,6,0" VerticalAlignment="Center" />
                                                <StackPanel VerticalAlignment="Center">
                                                    <TextBlock Text="{Binding DeviceName}" FontWeight="SemiBold" FontSize="12" Foreground="{StaticResource TextPrimaryBrush}" />
                                                    <TextBlock Text="{Binding EndpointText}" FontSize="10" Foreground="{StaticResource TextSecondaryBrush}" />
                                                </StackPanel>
                                            </StackPanel>
                                        </Button>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>

                            <!-- Manual IP/Port Entry & Send Button -->
                            <Grid Margin="0,4,0,0">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="90" />
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>

                                <TextBlock Grid.Column="0" Text="Target IP:" VerticalAlignment="Center" Margin="0,0,10,0"
                                           FontWeight="Medium" Foreground="{StaticResource TextSecondaryBrush}" />
                                <TextBox Grid.Column="1" Style="{StaticResource ModernTextBoxStyle}" Text="{Binding PeerHost, UpdateSourceTrigger=PropertyChanged}"
                                         Margin="0,0,10,0" VerticalAlignment="Center" />

                                <TextBlock Grid.Column="2" Text="Port:" VerticalAlignment="Center" Margin="0,0,8,0"
                                           FontWeight="Medium" Foreground="{StaticResource TextSecondaryBrush}" />
                                <TextBox Grid.Column="3" Style="{StaticResource ModernTextBoxStyle}" Text="{Binding PeerPort, UpdateSourceTrigger=PropertyChanged}"
                                         Margin="0,0,14,0" VerticalAlignment="Center" />

                                <Button Grid.Column="4" Style="{StaticResource SecondaryButtonStyle}" Content="🌐 Web Share"
                                        Command="{Binding StartWebShareCommand}" Margin="0,0,10,0" Padding="14,8"
                                        ToolTip="Share selected files with any web browser on local Wi-Fi without installing Glide" />

                                <Button Grid.Column="5" Style="{StaticResource PrimaryButtonStyle}" Content="🚀 Send Files"
                                        Command="{Binding SendFilesCommand}" MinWidth="130" />
                            </Grid>
                        </StackPanel>
                    </Border>
                </Grid>

                <!-- RECEIVE VIEW -->
                <Grid x:Name="ReceiveView">
                    <Grid.Style>
                        <Style TargetType="Grid">
                            <Setter Property="Visibility" Value="Collapsed" />
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding CurrentTab}" Value="Receive">
                                    <Setter Property="Visibility" Value="Visible" />
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </Grid.Style>

                    <Border Background="{StaticResource SurfaceBrush}" BorderBrush="{StaticResource CardBorderBrush}"
                            BorderThickness="1" CornerRadius="12" Padding="24">
                        <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center" MaxWidth="500">
                            <TextBlock Text="📡" FontSize="48" HorizontalAlignment="Center" Margin="0,0,0,12" />
                            <TextBlock Text="Receive Files on Local Network" FontSize="20" FontWeight="Bold"
                                       Foreground="{StaticResource TextPrimaryBrush}" HorizontalAlignment="Center" Margin="0,0,0,8" />
                            <TextBlock Text="Start the local receiver to accept incoming file transfers from Glide Android or Desktop devices on your Wi-Fi/LAN."
                                       FontSize="13" Foreground="{StaticResource TextSecondaryBrush}" TextAlignment="Center" TextWrapping="Wrap" Margin="0,0,0,24" />

                            <Border Background="{StaticResource SurfaceHighBrush}" CornerRadius="8" Padding="16" Margin="0,0,0,16">
                                <StackPanel>
                                    <Grid Margin="0,0,0,8">
                                        <TextBlock Text="Status:" Foreground="{StaticResource TextSecondaryBrush}" />
                                        <TextBlock Text="{Binding StatusMessage}" HorizontalAlignment="Right" FontWeight="SemiBold"
                                                   Foreground="{StaticResource SuccessBrush}" />
                                    </Grid>
                                    <Grid Margin="0,0,0,8">
                                        <TextBlock Text="Listening Port:" Foreground="{StaticResource TextSecondaryBrush}" />
                                        <TextBlock Text="{Binding ListeningPort}" HorizontalAlignment="Right" FontWeight="SemiBold" />
                                    </Grid>
                                    <Grid>
                                        <TextBlock Text="Local IP(s):" Foreground="{StaticResource TextSecondaryBrush}" />
                                        <TextBlock Text="{Binding LocalIpText}" HorizontalAlignment="Right" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" />
                                    </Grid>
                                </StackPanel>
                            </Border>

                            <!-- Active Pairing Invitation Link Card -->
                            <Border Background="{StaticResource SurfaceHighBrush}" CornerRadius="8" Padding="14,12" Margin="0,0,0,20"
                                    Visibility="{Binding IsListening, Converter={StaticResource BoolToVis}}">
                                <StackPanel>
                                    <TextBlock Text="🔗 Active Pairing Invitation Link" FontSize="12" FontWeight="SemiBold"
                                               Foreground="{StaticResource AccentBrush}" Margin="0,0,0,6" />
                                    <TextBox Style="{StaticResource ModernTextBoxStyle}" Text="{Binding ActiveInvitationUri, Mode=OneWay}"
                                             IsReadOnly="True" FontSize="10" Padding="8,5" Margin="0,0,0,8" />
                                    <Button Style="{StaticResource SecondaryButtonStyle}" Content="📋 Copy Pairing Link to Clipboard"
                                            Command="{Binding CopyPairingLinkCommand}" HorizontalAlignment="Center" Padding="16,5" FontSize="12" />
                                </StackPanel>
                            </Border>

                            <Button MinWidth="200" HorizontalAlignment="Center"
                                    Command="{Binding ToggleListenerCommand}">
                                <Button.Style>
                                    <Style TargetType="Button" BasedOn="{StaticResource PrimaryButtonStyle}">
                                        <Setter Property="Content" Value="▶ Start Listening" />
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding IsListening}" Value="True">
                                                <Setter Property="Content" Value="⏹ Stop Listening" />
                                                <Setter Property="Background" Value="{StaticResource ErrorBrush}" />
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </Button.Style>
                            </Button>
                        </StackPanel>
                    </Border>
                </Grid>

                <!-- HISTORY VIEW -->
                <Grid x:Name="HistoryView">
                    <Grid.Style>
                        <Style TargetType="Grid">
                            <Setter Property="Visibility" Value="Collapsed" />
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding CurrentTab}" Value="History">
                                    <Setter Property="Visibility" Value="Visible" />
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </Grid.Style>

                    <Border Background="{StaticResource SurfaceBrush}" BorderBrush="{StaticResource CardBorderBrush}"
                            BorderThickness="1" CornerRadius="12" Padding="16">
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="*" />
                            </Grid.RowDefinitions>

                            <TextBlock Grid.Row="0" Text="Transfer History" FontSize="16" FontWeight="Bold"
                                       Foreground="{StaticResource TextPrimaryBrush}" Margin="0,0,0,12" />

                            <ListBox Grid.Row="1" ItemsSource="{Binding HistoryItems}" Background="Transparent"
                                     BorderThickness="0" ScrollViewer.HorizontalScrollBarVisibility="Disabled">
                                <ListBox.ItemTemplate>
                                    <DataTemplate>
                                        <Border Background="{StaticResource SurfaceHighBrush}" CornerRadius="8" Padding="14,10" Margin="0,4">
                                            <Grid>
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="Auto" />
                                                    <ColumnDefinition Width="*" />
                                                    <ColumnDefinition Width="Auto" />
                                                    <ColumnDefinition Width="Auto" />
                                                    <ColumnDefinition Width="Auto" />
                                                </Grid.ColumnDefinitions>

                                                <TextBlock Grid.Column="0" Text="{Binding Direction}" FontWeight="Bold"
                                                           Foreground="{StaticResource AccentBrush}" Margin="0,0,12,0" VerticalAlignment="Center" />
                                                <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                                    <TextBlock Text="{Binding ItemName}" FontWeight="SemiBold" Foreground="{StaticResource TextPrimaryBrush}" />
                                                    <TextBlock Text="{Binding PeerName}" FontSize="11" Foreground="{StaticResource TextSecondaryBrush}" />
                                                </StackPanel>
                                                <TextBlock Grid.Column="2" Text="{Binding FormattedSize}" Margin="16,0"
                                                           Foreground="{StaticResource TextSecondaryBrush}" VerticalAlignment="Center" />
                                                <TextBlock Grid.Column="3" Text="{Binding FormattedTime}" Margin="16,0"
                                                           Foreground="{StaticResource TextSecondaryBrush}" VerticalAlignment="Center" />
                                                <Border Grid.Column="4" Background="{StaticResource SuccessBrush}" Opacity="0.9"
                                                        CornerRadius="4" Padding="6,2" VerticalAlignment="Center">
                                                    <TextBlock Text="Verified" FontSize="11" FontWeight="Bold" Foreground="#0D1121" />
                                                </Border>
                                            </Grid>
                                        </Border>
                                    </DataTemplate>
                                </ListBox.ItemTemplate>
                            </ListBox>
                        </Grid>
                    </Border>
                </Grid>
            </Grid>

            <!-- 3. Active Transfer Monitoring Bottom Bar -->
            <Border Grid.Row="2" Margin="0,16,0,0" Background="{StaticResource SurfaceBrush}"
                    BorderBrush="{StaticResource CardBorderBrush}" BorderThickness="1" CornerRadius="12" Padding="16,12"
                    Visibility="{Binding IsTransferActive, Converter={StaticResource BoolToVis}}">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>

                    <Grid Grid.Row="0" Margin="0,0,0,8">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="{Binding TransferTitle}" FontWeight="SemiBold" Foreground="{StaticResource AccentBrush}" />
                            <TextBlock Text=" • " Foreground="{StaticResource TextSecondaryBrush}" />
                            <TextBlock Text="{Binding CurrentFileName}" Foreground="{StaticResource TextPrimaryBrush}" TextTrimming="CharacterEllipsis" />
                        </StackPanel>
                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                            <TextBlock Text="{Binding TransferredBytesText}" Foreground="{StaticResource TextSecondaryBrush}" Margin="0,0,12,0" />
                            <TextBlock Text="{Binding TransferRateText}" FontWeight="Bold" Foreground="{StaticResource PrimaryBrush}" Margin="0,0,16,0" />
                            <Button Style="{StaticResource SecondaryButtonStyle}" Content="Cancel" Padding="8,2"
                                    Command="{Binding CancelTransferCommand}" Foreground="{StaticResource ErrorBrush}" />
                        </StackPanel>
                    </Grid>

                    <ProgressBar Grid.Row="1" Style="{StaticResource ModernProgressBarStyle}" Value="{Binding TotalProgress}" />
                </Grid>
            </Border>
        </Grid>

        <!-- SAS Mutual Verification Modal Overlay -->
        <Border Background="#CC070B16" Visibility="{Binding IsSasModalVisible, Converter={StaticResource BoolToVis}}"
                HorizontalAlignment="Stretch" VerticalAlignment="Stretch">
            <Border Background="{StaticResource SurfaceBrush}" BorderBrush="{StaticResource CardBorderBrush}"
                    BorderThickness="1" CornerRadius="16" Padding="28" Width="440" HorizontalAlignment="Center"
                    VerticalAlignment="Center">
                <StackPanel HorizontalAlignment="Center">
                    <TextBlock Text="🛡️" FontSize="36" HorizontalAlignment="Center" Margin="0,0,0,8" />
                    <TextBlock Text="Confirm Mutual Verification Code" FontSize="17" FontWeight="Bold"
                               Foreground="{StaticResource TextPrimaryBrush}" HorizontalAlignment="Center" Margin="0,0,0,8" />
                    <TextBlock Text="Verify that the 6-digit code below matches the code displayed on the peer screen:"
                               FontSize="13" Foreground="{StaticResource TextSecondaryBrush}" TextAlignment="Center" TextWrapping="Wrap" Margin="0,0,0,20" />

                    <!-- 6-digit SAS code -->
                    <Border Background="{StaticResource SurfaceHighBrush}" BorderBrush="{StaticResource AccentBrush}"
                            BorderThickness="1" CornerRadius="10" Padding="24,12" HorizontalAlignment="Center" Margin="0,0,0,24">
                        <TextBlock Text="{Binding SasCode}" FontSize="32" FontWeight="Bold"
                                   Foreground="{StaticResource AccentBrush}" HorizontalAlignment="Center" />
                    </Border>

                    <!-- Actions -->
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="16" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <Button Grid.Column="0" Style="{StaticResource SecondaryButtonStyle}" Content="Cancel"
                                Command="{Binding RejectSasCommand}" Padding="0,10" />
                        <Button Grid.Column="2" Style="{StaticResource PrimaryButtonStyle}" Content="Confirm Code"
                                Command="{Binding ConfirmSasCommand}" Padding="0,10" />
                    </Grid>
                </StackPanel>
            </Border>
        </Border>

        <!-- Pair via Link / QR Modal Overlay -->
        <Border Background="#CC070B16" Visibility="{Binding IsPairModalVisible, Converter={StaticResource BoolToVis}}"
                HorizontalAlignment="Stretch" VerticalAlignment="Stretch">
            <Border Background="{StaticResource SurfaceBrush}" BorderBrush="{StaticResource CardBorderBrush}"
                    BorderThickness="1" CornerRadius="16" Padding="28" Width="480" HorizontalAlignment="Center"
                    VerticalAlignment="Center">
                <StackPanel HorizontalAlignment="Center" MaxWidth="440">
                    <TextBlock Text="🔗" FontSize="36" HorizontalAlignment="Center" Margin="0,0,0,8" />
                    <TextBlock Text="Pair with Device via Link" FontSize="17" FontWeight="Bold"
                               Foreground="{StaticResource TextPrimaryBrush}" HorizontalAlignment="Center" Margin="0,0,0,8" />
                    <TextBlock Text="Paste the Glide pairing invitation link (glide://pair/v1#...) or scanned QR payload from your mobile or desktop peer:"
                               FontSize="13" Foreground="{StaticResource TextSecondaryBrush}" TextAlignment="Center" TextWrapping="Wrap" Margin="0,0,0,16" />

                    <TextBox Style="{StaticResource ModernTextBoxStyle}" Text="{Binding PairInputUri, UpdateSourceTrigger=PropertyChanged}"
                             Height="60" TextWrapping="Wrap" AcceptsReturn="False" Margin="0,0,0,20" Padding="8" />

                    <!-- Actions -->
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="16" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <Button Grid.Column="0" Style="{StaticResource SecondaryButtonStyle}" Content="Cancel"
                                Command="{Binding CancelPairModalCommand}" Padding="0,10" />
                        <Button Grid.Column="2" Style="{StaticResource PrimaryButtonStyle}" Content="Pair Device"
                                Command="{Binding SubmitPairModalCommand}" Padding="0,10" />
                    </Grid>
                </StackPanel>
            </Border>
        </Border>

        <!-- Web Share Active Modal Overlay -->
        <Border Background="#CC070B16" Visibility="{Binding IsWebShareModalVisible, Converter={StaticResource BoolToVis}}"
                HorizontalAlignment="Stretch" VerticalAlignment="Stretch">
            <Border Background="{StaticResource SurfaceBrush}" BorderBrush="{StaticResource CardBorderBrush}"
                    BorderThickness="1" CornerRadius="16" Padding="28" Width="520" HorizontalAlignment="Center"
                    VerticalAlignment="Center">
                <StackPanel HorizontalAlignment="Center" MaxWidth="480">
                    <TextBlock Text="🌐" FontSize="36" HorizontalAlignment="Center" Margin="0,0,0,8" />
                    <TextBlock Text="Web Browser Transfer Active" FontSize="18" FontWeight="Bold"
                               Foreground="{StaticResource TextPrimaryBrush}" HorizontalAlignment="Center" Margin="0,0,0,6" />
                    <TextBlock Text="Open this single-use link on any browser (iOS, Android, macOS, Linux, ChromeOS) connected to the same Wi-Fi network to download or upload files:"
                               FontSize="13" Foreground="{StaticResource TextSecondaryBrush}" TextAlignment="Center" TextWrapping="Wrap" Margin="0,0,0,16" />

                    <!-- Web Share URL Box -->
                    <Border Background="{StaticResource SurfaceHighBrush}" BorderBrush="{StaticResource CardBorderBrush}"
                            BorderThickness="1" CornerRadius="8" Padding="12,10" Margin="0,0,0,12">
                        <TextBox Style="{StaticResource ModernTextBoxStyle}" Text="{Binding WebShareUrl, Mode=OneWay}"
                                 IsReadOnly="True" FontSize="12" Background="Transparent" BorderThickness="0"
                                 TextWrapping="Wrap" Foreground="{StaticResource AccentBrush}" FontWeight="SemiBold" />
                    </Border>

                    <Button Style="{StaticResource SecondaryButtonStyle}" Content="📋 Copy Web Share Link"
                            Command="{Binding CopyWebShareLinkCommand}" HorizontalAlignment="Center" Padding="16,6" Margin="0,0,0,16" />

                    <TextBlock Text="⚠️ Single-use onboarding token expires in 120 seconds if not opened. Transfer stays 100% on your local network."
                               FontSize="11" Foreground="{StaticResource TextSecondaryBrush}" TextAlignment="Center" TextWrapping="Wrap" Margin="0,0,0,20" />

                    <!-- Stop Button -->
                    <Button Style="{StaticResource PrimaryButtonStyle}" Content="⏹ Stop Web Share"
                            Command="{Binding StopWebShareCommand}" Width="160" HorizontalAlignment="Center" Padding="0,10"
                            Background="{StaticResource ErrorBrush}" />
                </StackPanel>
            </Border>
        </Border>
    </Grid>
</Window>
