<?xml version="1.0" encoding="utf-8"?>
<full-backup-content>
    <!-- Explicitly disallow legacy full backups of transfer history, received files, and settings -->
    <exclude domain="root" />
    <exclude domain="database" />
    <exclude domain="sharedpref" />
    <exclude domain="file" />
    <exclude domain="external" />
</full-backup-content>
