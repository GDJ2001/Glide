{
  "version": "0.2.0",
  "configurations": [
    {
      "name": "Doctor (PowerShell)",
      "type": "PowerShell",
      "request": "launch",
      "script": "${workspaceFolder}/tools/doctor.ps1"
    },
    {
      "name": "Build All (PowerShell)",
      "type": "PowerShell",
      "request": "launch",
      "script": "${workspaceFolder}/tools/build.ps1",
      "args": ["-Configuration", "Debug", "-Target", "All"]
    },
    {
      "name": "Build Android (PowerShell)",
      "type": "PowerShell",
      "request": "launch",
      "script": "${workspaceFolder}/tools/build.ps1",
      "args": ["-Configuration", "Debug", "-Target", "Android"]
    },
    {
      "name": "Build Windows (PowerShell)",
      "type": "PowerShell",
      "request": "launch",
      "script": "${workspaceFolder}/tools/build.ps1",
      "args": ["-Configuration", "Debug", "-Target", "Windows"]
    },
    {
      "name": "Test All (PowerShell)",
      "type": "PowerShell",
      "request": "launch",
      "script": "${workspaceFolder}/tools/test.ps1",
      "args": ["-Target", "All"]
    },
    {
      "name": "Verify (PowerShell)",
      "type": "PowerShell",
      "request": "launch",
      "script": "${workspaceFolder}/tools/verify.ps1"
    },
    {
      "name": "Run Windows UI (.NET)",
      "type": "coreclr",
      "request": "launch",
      "preLaunchTask": "build-windows",
      "program": "${workspaceFolder}/desktop/windows/Glide.Windows.UI/bin/Debug/net10.0-windows/Glide.dll",
      "cwd": "${workspaceFolder}/desktop/windows/Glide.Windows.UI",
      "console": "internalConsole",
      "justMyCode": false
    },
    {
      "name": "Run Windows CLI — Receive (.NET)",
      "type": "coreclr",
      "request": "launch",
      "preLaunchTask": "build-windows",
      "program": "${workspaceFolder}/desktop/src/Glide.App/bin/Debug/net10.0/Glide.App.dll",
      "args": ["receive", "--port", "42424"],
      "cwd": "${workspaceFolder}/desktop/src/Glide.App",
      "console": "internalConsole"
    },
    {
      "name": "Run Windows CLI — Help (.NET)",
      "type": "coreclr",
      "request": "launch",
      "preLaunchTask": "build-windows",
      "program": "${workspaceFolder}/desktop/src/Glide.App/bin/Debug/net10.0/Glide.App.dll",
      "args": ["--help"],
      "cwd": "${workspaceFolder}/desktop/src/Glide.App",
      "console": "internalConsole"
    }
  ]
}
