<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:Glide.Linux.UI.ViewModels"
             x:Class="Glide.Linux.UI.Views.Pages.ReceivePage"
             x:DataType="vm:LinuxMainViewModel">

  <ScrollViewer VerticalScrollBarVisibility="Auto">
    <StackPanel Spacing="16" Margin="0,0,8,0">

      <!-- Header -->
      <StackPanel Spacing="4">
        <TextBlock Text="Receive" Classes="h1" />
        <TextBlock Text="Make this computer available to nearby Glide devices. You approve each incoming transfer." Classes="secondary" TextWrapping="Wrap" />
      </StackPanel>

      <!-- Receiving control follows the same order as Windows. -->
      <Border Classes="card">
        <StackPanel Spacing="12">
          <TextBlock Text="{Binding ReceivingStatusText}" Classes="h2" />
          <TextBlock Text="Nearby devices can scan your one-time QR code. You will still review every offer."
                     Classes="secondary" TextWrapping="Wrap" />
          <Button Content="{Binding ReceivingButtonText}" Command="{Binding ToggleListenerCommand}"
                  Classes="primary" HorizontalAlignment="Left" AutomationProperties.Name="Toggle receiving files" />
        </StackPanel>
      </Border>

      <Border Classes="card">
        <StackPanel Spacing="12">
          <TextBlock Text="Connect a phone" Classes="h3" />
          <TextBlock Text="Open Glide on the phone, choose Send files, then scan this code."
                     Classes="secondary" TextWrapping="Wrap" />
          <StackPanel Spacing="12" IsVisible="{Binding IsListening}">
          <Border Background="{DynamicResource StatusWarningBackgroundBrush}"
                  BorderBrush="{DynamicResource StatusWarningBrush}" BorderThickness="1"
                  CornerRadius="8" Padding="12" IsVisible="{Binding !IsNetworkReady}"
                  AutomationProperties.Name="Network reachability warning">
            <Grid ColumnDefinitions="Auto,*">
              <PathIcon Data="{StaticResource IconWarning}" Width="20" Height="20"
                        Margin="0,0,10,0" Foreground="{DynamicResource StatusWarningBrush}" VerticalAlignment="Top" />
              <TextBlock Grid.Column="1" Text="{Binding NetworkGuidanceMessage}" Classes="body"
                         TextWrapping="Wrap" />
            </Grid>
          </Border>
          <Grid ColumnDefinitions="Auto,*" IsVisible="{Binding IsNetworkReady}">
            <Border Background="White" Padding="10" CornerRadius="10" VerticalAlignment="Top" Margin="0,0,20,0">
              <Image Source="{Binding PairingQrImage}" Width="180" Height="180" Stretch="Uniform"
                     AutomationProperties.Name="One-time QR code for receiving files" />
            </Border>
            <StackPanel Grid.Column="1" Spacing="8" VerticalAlignment="Center" Width="192" HorizontalAlignment="Left">
              <Button x:Name="EnlargeReceiveQrButton" Content="Show larger code"
                      Command="{Binding OpenReceiveQrCommand}" IsEnabled="{Binding HasActiveInvitation}"
                      Classes="primary" HorizontalAlignment="Stretch" />
              <Button x:Name="CopyLinkButton" Content="Copy receive link" Classes="secondary"
                      HorizontalAlignment="Stretch" AutomationProperties.Name="Copy receiving link to clipboard" />
              <Button Content="Refresh code" Command="{Binding RefreshInvitationCommand}"
                      Classes="secondary" HorizontalAlignment="Stretch" />
            </StackPanel>
          </Grid>
          </StackPanel>
        </StackPanel>
      </Border>

    </StackPanel>
  </ScrollViewer>

</UserControl>
