<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:Glide.Linux.UI.ViewModels"
             x:Class="Glide.Linux.UI.Views.Pages.SendPage"
             x:DataType="vm:LinuxMainViewModel">

  <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
    <StackPanel Spacing="20" Margin="0,0,8,0">

      <!-- Page Header -->
      <StackPanel Spacing="4">
        <TextBlock Text="Send Files" Classes="h1" />
        <TextBlock Text="Select files or folders, choose a sharing method, and send securely peer-to-peer."
                   Classes="secondary" TextWrapping="Wrap" />
      </StackPanel>

      <!-- TRANSFORMING FILE QUEUE (LUI-06) -->
      <!-- Empty Drop State -->
      <Border Classes="drop-target" IsVisible="{Binding HasNoStagedItems}">
        <StackPanel Spacing="14" HorizontalAlignment="Stretch" VerticalAlignment="Center" Margin="12">
          <PathIcon Data="{StaticResource IconFolder}" Width="48" Height="48"
                    Foreground="{DynamicResource AccentPrimaryBrush}" HorizontalAlignment="Center" />
          <StackPanel Spacing="4" HorizontalAlignment="Stretch">
            <TextBlock Text="Drag and drop files or folders here" Classes="h2" HorizontalAlignment="Stretch" TextAlignment="Center" TextWrapping="Wrap" />
            <TextBlock Text="Files are transferred directly over your local network. No cloud servers are used."
                       Classes="secondary" HorizontalAlignment="Stretch" TextAlignment="Center" TextWrapping="Wrap" />
          </StackPanel>
          <StackPanel Orientation="Horizontal" Spacing="12" HorizontalAlignment="Center" Margin="0,8,0,0">
            <Button x:Name="AddFilesEmptyButton" Content="Add files..." Classes="primary"
                    AutomationProperties.Name="Add files to send" />
            <Button x:Name="AddFolderEmptyButton" Content="Add folder..." Classes="secondary"
                    AutomationProperties.Name="Add folder to send" />
          </StackPanel>
        </StackPanel>
      </Border>

      <!-- Staged Items List State -->
      <Border Classes="card" IsVisible="{Binding HasStagedItems}">
        <Grid RowDefinitions="Auto,*,Auto">
          <!-- Queue Header -->
          <Grid Grid.Row="0" RowDefinitions="Auto,Auto" Margin="0,0,0,14">
            <StackPanel Grid.Row="0" VerticalAlignment="Center">
              <TextBlock Classes="h3">
                <TextBlock.Text>
                  <MultiBinding StringFormat="{}{0} item(s) staged ({1})">
                    <Binding Path="StagedCount" />
                    <Binding Path="FormattedTotalStagedBytes" />
                  </MultiBinding>
                </TextBlock.Text>
              </TextBlock>
              <TextBlock Text="Files ready to be sent" Classes="small" />
            </StackPanel>
            <WrapPanel Grid.Row="1" Margin="0,10,0,0">
              <Button x:Name="AddFilesStagedButton" Content="Add files..." Classes="secondary"
                      Margin="0,0,8,8"
                      AutomationProperties.Name="Add more files" />
              <Button x:Name="AddFolderStagedButton" Content="Add folder..." Classes="secondary"
                      Margin="0,0,8,8"
                      AutomationProperties.Name="Add more folders" />
              <Button Content="Clear all" Command="{Binding ClearStagedItemsCommand}" Classes="secondary"
                      Margin="0,0,8,8"
                      AutomationProperties.Name="Clear all staged files" />
            </WrapPanel>
          </Grid>

          <!-- Staged Items Scroll List -->
          <ScrollViewer Grid.Row="1" MaxHeight="200" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
            <ItemsControl ItemsSource="{Binding StagedItems}">
              <ItemsControl.ItemTemplate>
                <DataTemplate>
                  <Border BorderBrush="{DynamicResource BorderSubtleBrush}" BorderThickness="0,0,0,1"
                          Padding="10,8">
                    <Grid ColumnDefinitions="Auto,*,Auto,Auto">
                      <PathIcon Grid.Column="0" Data="{StaticResource IconFile}" Width="18" Height="18"
                                Foreground="{DynamicResource TextSecondaryBrush}" VerticalAlignment="Center"
                                Margin="0,0,12,0" />
                      <StackPanel Grid.Column="1" VerticalAlignment="Center">
                        <TextBlock Text="{Binding Name}" FontWeight="SemiBold" Classes="body" TextTrimming="CharacterEllipsis" />
                        <TextBlock Text="{Binding FullPath}" Classes="muted" TextTrimming="CharacterEllipsis" />
                      </StackPanel>
                      <TextBlock Grid.Column="2" Text="{Binding FormattedSize}" VerticalAlignment="Center"
                                 Margin="16,0" Classes="secondary" />
                      <Button Grid.Column="3" Content="✕"
                              Command="{Binding RemoveCommand}"
                              Background="Transparent" BorderThickness="0"
                              Foreground="{DynamicResource StatusErrorBrush}" Padding="8,4"
                              ToolTip.Tip="Remove item"
                              AutomationProperties.Name="Remove staged item" />
                    </Grid>
                  </Border>
                </DataTemplate>
              </ItemsControl.ItemTemplate>
            </ItemsControl>
          </ScrollViewer>
        </Grid>
      </Border>

      <!-- Two sending methods: one-time QR or saved identity. -->
      <Border Classes="card">
        <StackPanel Spacing="16">
          <TextBlock Text="Choose Sending Method" Classes="h3" />

          <!-- Method Segmented Buttons -->
          <Grid ColumnDefinitions="*,*">
            <Button Grid.Column="0"
                    Command="{Binding SelectSendMethodCommand}" CommandParameter="QuickShareQr"
                    Classes="method-tab" Classes.selected="{Binding IsQuickShareMethodSelected}"
                    HorizontalAlignment="Stretch" HorizontalContentAlignment="Stretch" Margin="0,0,4,0"
                    AutomationProperties.Name="Send method: Quick share with QR code">
              <TextBlock Text="Quick share with QR" TextWrapping="Wrap" TextAlignment="Center" />
            </Button>
            <Button Grid.Column="1" Content="Paired device"
                    Command="{Binding SelectSendMethodCommand}" CommandParameter="SavedDevice"
                    Classes="method-tab" Classes.selected="{Binding IsSavedMethodSelected}"
                    HorizontalAlignment="Stretch" HorizontalContentAlignment="Center" Margin="4,0,0,0"
                    AutomationProperties.Name="Send method: Paired device" />
          </Grid>

          <!-- Method 1: Quick Share with QR -->
          <StackPanel Spacing="12" IsVisible="{Binding IsQuickShareMethodSelected}">
            <!-- Network Guidance / NAT warning banner when not ready -->
            <Border Classes="card" Background="{DynamicResource StatusWarningBackgroundBrush}"
                    BorderBrush="{DynamicResource StatusWarningBrush}" BorderThickness="1"
                    CornerRadius="8" Padding="12" IsVisible="{Binding !IsNetworkReady}"
                    AutomationProperties.Name="Network reachability warning">
              <Grid ColumnDefinitions="Auto,*">
                <PathIcon Grid.Column="0" Data="{StaticResource IconWarning}" Width="20" Height="20"
                          Margin="0,0,10,0" Foreground="{DynamicResource StatusWarningBrush}" VerticalAlignment="Top" />
                <TextBlock Grid.Column="1" Text="{Binding NetworkGuidanceMessage}" Classes="body"
                           TextWrapping="Wrap" VerticalAlignment="Center" />
              </Grid>
            </Border>

            <TextBlock Text="Quick share creates an instant one-time QR code. The receiving device scans the code in Glide to connect. You will confirm the recipient's device name before any files are transmitted."
                       Classes="secondary" TextWrapping="Wrap" />
            <Button Content="Start quick share with QR"
                    Command="{Binding StartQuickShareCommand}"
                    Classes="primary" HorizontalAlignment="Left"
                    AutomationProperties.Name="Start quick share with QR code" />
          </StackPanel>

          <!-- Method 2: Paired Device -->
          <StackPanel Spacing="14" IsVisible="{Binding IsSavedMethodSelected}">

            <!-- Saved Peers List -->
            <Border Background="{DynamicResource SurfaceRaisedBrush}" CornerRadius="8" Padding="8">
              <StackPanel Spacing="6">
                <ListBox ItemsSource="{Binding TrustedPeers}" SelectedItem="{Binding SelectedTrustedPeer}"
                         MaxHeight="140" Background="Transparent" BorderThickness="0">
                  <ListBox.ItemTemplate>
                    <DataTemplate>
                      <Grid ColumnDefinitions="Auto,*,Auto" Margin="4,2">
                        <PathIcon Grid.Column="0" Data="{StaticResource IconPair}" Width="20" Height="20"
                                  Foreground="{DynamicResource AccentPrimaryBrush}" VerticalAlignment="Center"
                                  Margin="0,0,12,0" />
                        <StackPanel Grid.Column="1" VerticalAlignment="Center">
                          <TextBlock Text="{Binding DisplayName}" FontWeight="SemiBold" Classes="body" />
                        </StackPanel>
                        <TextBlock Grid.Column="2" Text="Verified" Classes="small" VerticalAlignment="Center"
                                   Foreground="{DynamicResource StatusSuccessBrush}" />
                      </Grid>
                    </DataTemplate>
                  </ListBox.ItemTemplate>
                </ListBox>
                <TextBlock Text="No saved devices yet. Connect with a device and accept pairing to save its identity."
                           Classes="muted" IsVisible="{Binding !TrustedPeers.Count}"
                           HorizontalAlignment="Center" Margin="12" />
              </StackPanel>
            </Border>

            <Button Content="Send to paired device"
                    Command="{Binding SendFilesCommand}"
                    Classes="primary" HorizontalAlignment="Left"
                    AutomationProperties.Name="Send files to selected saved device" />
          </StackPanel>

        </StackPanel>
      </Border>

    </StackPanel>
  </ScrollViewer>

</UserControl>
