<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:Glide.Linux.UI.ViewModels"
             x:Class="Glide.Linux.UI.Views.Pages.ActivityPage"
             x:DataType="vm:LinuxMainViewModel">

  <ScrollViewer VerticalScrollBarVisibility="Auto">
    <StackPanel Spacing="20" Margin="0,0,8,0">

      <!-- Header & Top Actions -->
      <Grid ColumnDefinitions="*,Auto,Auto">
        <StackPanel Grid.Column="0" Spacing="4">
          <TextBlock Text="Activity" Classes="h1" />
          <TextBlock Text="Current transfers and verified file history." Classes="secondary" />
        </StackPanel>

        <Button Grid.Column="1" Content="Received files"
                Command="{Binding OpenDownloadsDirectoryCommand}"
                Classes="secondary" Margin="0,0,8,0" VerticalAlignment="Center"
                AutomationProperties.Name="Open downloads directory in file manager" />

        <Button Grid.Column="2" Content="Clear history"
                Command="{Binding ClearHistoryCommand}"
                Classes="secondary" VerticalAlignment="Center"
                AutomationProperties.Name="Clear transfer history" />
      </Grid>

      <!-- Active Transfer Card (LUI-07: Active batch first) -->
      <Border Classes="card" BorderBrush="{DynamicResource AccentPrimaryBrush}"
              BorderThickness="1.5" IsVisible="{Binding Transfer.IsActive}">
        <Grid RowDefinitions="Auto,Auto,Auto" ColumnDefinitions="*,Auto">
          <StackPanel Grid.Row="0" Grid.Column="0" Orientation="Horizontal" Spacing="8">
            <Ellipse Classes="status-dot active" VerticalAlignment="Center" />
            <TextBlock Text="{Binding Transfer.Title}" Classes="h3" VerticalAlignment="Center" />
          </StackPanel>

          <TextBlock Grid.Row="0" Grid.Column="1" Text="{Binding Transfer.RateText}"
                     FontWeight="SemiBold" Foreground="{DynamicResource AccentPrimaryBrush}"
                     VerticalAlignment="Center" />

          <ProgressBar Grid.Row="1" Grid.Column="0" Grid.ColumnSpan="2"
                       Value="{Binding Transfer.Progress}" IsIndeterminate="{Binding Transfer.IsIndeterminate}" Maximum="100"
                       Height="8" Margin="0,12" CornerRadius="4" />

          <StackPanel Grid.Row="2" Grid.Column="0" Spacing="2">
            <TextBlock Text="{Binding Transfer.PhaseText}" Classes="secondary" />
            <TextBlock Text="{Binding Transfer.CurrentFile}" Classes="body" FontWeight="Medium"
                       TextTrimming="CharacterEllipsis" />
            <TextBlock Text="{Binding Transfer.BytesText}" Classes="muted" />
          </StackPanel>

          <Button Grid.Row="2" Grid.Column="1" Content="Cancel transfer"
                  Command="{Binding CancelTransferCommand}"
                  Classes="danger" VerticalAlignment="Center"
                  AutomationProperties.Name="Cancel active transfer" />
        </Grid>
      </Border>

      <Border Classes="card" IsVisible="{Binding Transfer.HasResult}">
        <StackPanel Spacing="8">
          <TextBlock Text="{Binding Transfer.Title}" Classes="h3" />
          <TextBlock Text="{Binding Transfer.PeerName}" Classes="secondary" />
          <TextBlock Text="{Binding Transfer.ResultSummary}" TextWrapping="Wrap" Classes="body" />
          <TextBlock Text="{Binding Transfer.VerifiedSummary}" IsVisible="{Binding Transfer.HasVerifiedSummary}" Classes="secondary" />
          <Expander Header="Technical details" IsVisible="{Binding Transfer.HasDetails}">
            <TextBlock Text="{Binding Transfer.Details}" TextWrapping="Wrap" Margin="0,8,0,0" />
          </Expander>
          <StackPanel Orientation="Horizontal" Spacing="8" Margin="0,8,0,0">
            <Button Content="Open folder" Command="{Binding OpenTransferFolderCommand}" IsVisible="{Binding Transfer.CanOpenFolder}" Classes="primary" />
            <Button Content="Try again" Command="{Binding RetryTransferCommand}" IsVisible="{Binding Transfer.CanRetry}" Classes="secondary" />
          </StackPanel>
        </StackPanel>
      </Border>

      <Border Classes="card" IsVisible="{Binding Transfer.HasPreviousResults}">
        <StackPanel Spacing="8">
          <TextBlock Text="Earlier this session" Classes="h3" />
          <ItemsControl ItemsSource="{Binding Transfer.PreviousResults}">
            <ItemsControl.ItemTemplate>
              <DataTemplate>
                <Grid ColumnDefinitions="Auto,*" Margin="0,4">
                  <TextBlock Text="{Binding Title}" FontWeight="SemiBold" />
                  <TextBlock Grid.Column="1" Text="{Binding PeerName}" Classes="secondary"
                             TextTrimming="CharacterEllipsis" Margin="12,0,0,0" />
                </Grid>
              </DataTemplate>
            </ItemsControl.ItemTemplate>
          </ItemsControl>
        </StackPanel>
      </Border>

      <!-- History Section with Search and Filter -->
      <Border Classes="card">
        <StackPanel Spacing="16">
          <Grid x:Name="HistoryHeaderGrid" ColumnDefinitions="*,Auto" RowDefinitions="Auto,Auto">
            <TextBlock Grid.Column="0" Text="Verified history" Classes="h3" VerticalAlignment="Center" />
            <StackPanel x:Name="HistoryHeaderActions" Grid.Column="1" Orientation="Horizontal" Spacing="8" HorizontalAlignment="Right">
              <TextBox x:Name="ActivitySearchTextBox" Text="{Binding History.SearchQuery}" Width="170"
                       PlaceholderText="Search history" AutomationProperties.Name="Search transfer history" />
              <!-- Filter Buttons: All, Sent, Received -->
              <Button Content="All" Command="{Binding SelectActivityFilterCommand}" CommandParameter="All"
                      Classes="method-tab"
                      AutomationProperties.Name="Filter all transfers" />
              <Button Content="Sent" Command="{Binding SelectActivityFilterCommand}" CommandParameter="Sent"
                      Classes="method-tab"
                      AutomationProperties.Name="Filter sent transfers" />
              <Button Content="Received" Command="{Binding SelectActivityFilterCommand}" CommandParameter="Received"
                      Classes="method-tab"
                      AutomationProperties.Name="Filter received transfers" />
            </StackPanel>
          </Grid>

          <!-- History Items List -->
          <ScrollViewer MaxHeight="380" VerticalScrollBarVisibility="Auto">
            <StackPanel>
              <ItemsControl ItemsSource="{Binding History.FilteredItems}">
                <ItemsControl.ItemTemplate>
                  <DataTemplate>
                    <Border BorderBrush="{DynamicResource BorderSubtleBrush}" BorderThickness="0,0,0,1"
                            Padding="12,10">
                      <Grid ColumnDefinitions="Auto,*,Auto,Auto">
                        <!-- Direction Icon -->
                        <Border Grid.Column="0" Background="{DynamicResource SurfaceRaisedBrush}"
                                CornerRadius="6" Width="36" Height="36" Margin="0,0,14,0"
                                VerticalAlignment="Center">
                          <PathIcon Data="{StaticResource IconActivity}" Width="16" Height="16"
                                    Foreground="{DynamicResource AccentPrimaryBrush}"
                                    HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>

                        <!-- Peer and Item Details -->
                        <StackPanel Grid.Column="1" VerticalAlignment="Center" Spacing="2">
                          <StackPanel Orientation="Horizontal" Spacing="8">
                            <TextBlock Text="{Binding PeerName}" FontWeight="SemiBold" Classes="body" />
                            <TextBlock Text="{Binding Direction}" Classes="small" Foreground="{DynamicResource TextSecondaryBrush}" />
                          </StackPanel>
                          <TextBlock Text="{Binding FormattedTimestamp}" Classes="muted" />
                        </StackPanel>

                        <!-- Size & Item Count -->
                        <TextBlock Grid.Column="2" Text="{Binding FormattedTotalBytes}"
                                   VerticalAlignment="Center" Margin="16,0" Classes="secondary" />

                        <!-- Status Badge -->
                        <Border Grid.Column="3" Background="{DynamicResource StatusSuccessBackgroundBrush}"
                                CornerRadius="6" Padding="10,4" VerticalAlignment="Center">
                          <TextBlock Text="{Binding Status}" FontWeight="SemiBold" Classes="small"
                                     Foreground="{DynamicResource StatusSuccessBrush}" />
                        </Border>
                      </Grid>
                    </Border>
                  </DataTemplate>
                </ItemsControl.ItemTemplate>
              </ItemsControl>

              <!-- Empty State -->
              <StackPanel IsVisible="{Binding !History.HasResults}"
                          Spacing="8" HorizontalAlignment="Center" Margin="24">
                <PathIcon Data="{StaticResource IconActivity}" Width="36" Height="36"
                          Foreground="{DynamicResource TextMutedBrush}" HorizontalAlignment="Center" />
                <TextBlock Text="{Binding History.EmptyTitle}" Classes="h3" HorizontalAlignment="Center" />
                <TextBlock Text="{Binding History.EmptyDescription}"
                           Classes="muted" HorizontalAlignment="Center" />
              </StackPanel>
            </StackPanel>
          </ScrollViewer>

        </StackPanel>
      </Border>

    </StackPanel>
  </ScrollViewer>

</UserControl>
