<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:Glide.Linux.UI.ViewModels"
             x:Class="Glide.Linux.UI.Views.Pages.ResumableTransfersCard"
             x:DataType="vm:LinuxMainViewModel" IsVisible="{Binding HasResumeEntries}">
  <Border Classes="card">
    <StackPanel Spacing="8">
      <TextBlock Text="Resumable transfers" Classes="h3" />
      <ItemsControl ItemsSource="{Binding ResumeEntries}">
        <ItemsControl.ItemTemplate>
          <DataTemplate x:CompileBindings="False">
            <Grid ColumnDefinitions="*,Auto" Margin="0,4">
              <TextBlock Text="{Binding Label}" VerticalAlignment="Center" TextWrapping="Wrap" />
              <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="6" Margin="12,0,0,0">
                <Button Classes="icon-action"
                        ToolTip.Tip="Resume transfer"
                        AutomationProperties.Name="Resume transfer"
                        Command="{Binding $parent[ItemsControl].DataContext.ResumeInterruptedTransferCommand}"
                        CommandParameter="{Binding}">
                  <PathIcon Data="{StaticResource IconPlay}" Width="14" Height="14"
                            Foreground="{DynamicResource AccentPrimaryBrush}" />
                </Button>
                <Button Classes="icon-danger"
                        ToolTip.Tip="Cancel transfer"
                        AutomationProperties.Name="Cancel transfer"
                        Command="{Binding $parent[ItemsControl].DataContext.DiscardInterruptedTransferCommand}"
                        CommandParameter="{Binding}">
                  <PathIcon Data="{StaticResource IconClose}" Width="14" Height="14" />
                </Button>
              </StackPanel>
            </Grid>
          </DataTemplate>
        </ItemsControl.ItemTemplate>
      </ItemsControl>
    </StackPanel>
  </Border>
</UserControl>
