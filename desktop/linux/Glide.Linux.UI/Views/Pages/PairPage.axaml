<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:Glide.Linux.UI.ViewModels"
             x:Class="Glide.Linux.UI.Views.Pages.PairPage"
             x:DataType="vm:LinuxMainViewModel">
  <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
    <StackPanel Spacing="16" Margin="0,0,8,0">
      <StackPanel Spacing="4">
        <TextBlock Text="Pair devices" Classes="h1" />
        <TextBlock Text="Connect with another Glide device." Classes="secondary" TextWrapping="Wrap" />
      </StackPanel>

      <Border Classes="card">
        <StackPanel Spacing="14">
          <TextBlock Text="Pair devices" Classes="h2" />
          <WrapPanel>
            <Button Content="Find devices" Command="{Binding FindPairDevicesCommand}"
                    Classes="primary" Margin="0,0,8,8"
                    AutomationProperties.Name="Find pair-ready Glide devices" />
            <Button Content="Show my QR and code" Command="{Binding ReadyToPairCommand}"
                    Classes="secondary" Margin="0,0,8,8"
                    AutomationProperties.Name="Show this computer's pairing QR and code" />
            <Button Content="Enter pairing link" Command="{Binding ShowPairLinkCommand}"
                    Classes="secondary" Margin="0,0,8,8" />
            <Button Content="Pair by address" Command="{Binding ShowPairAddressCommand}"
                    Classes="secondary" Margin="0,0,0,8" />
          </WrapPanel>

          <StackPanel Spacing="10" IsVisible="{Binding IsPairDiscovery}">
            <TextBlock Text="{Binding Pairing.Message}" Classes="secondary" TextWrapping="Wrap" />
            <Border Background="{DynamicResource StatusWarningBackgroundBrush}"
                    BorderBrush="{DynamicResource StatusWarningBrush}" BorderThickness="1"
                    CornerRadius="8" Padding="12" IsVisible="{Binding HasDiscoveryDiagnostic}"
                    AutomationProperties.Name="Discovery diagnostic notice">
              <StackPanel Spacing="8">
                <TextBlock Text="{Binding DiscoveryDiagnosticSummary}" Classes="body" TextWrapping="Wrap" />
                <Expander Header="Technical details" IsVisible="{Binding HasDiscoveryTechnicalDetails}" HorizontalAlignment="Stretch">
                  <TextBlock Text="{Binding DiscoveryTechnicalDetails}" Classes="muted"
                             FontFamily="{DynamicResource FontFamilyMonospace}" TextWrapping="Wrap" Margin="0,6,0,0" />
                </Expander>
              </StackPanel>
            </Border>
            <ListBox ItemsSource="{Binding DiscoveredPeers}" SelectedItem="{Binding SelectedPeer}"
                     MaxHeight="200" AutomationProperties.Name="Nearby Glide devices">
              <ListBox.ItemTemplate>
                <DataTemplate>
                  <Grid ColumnDefinitions="*,Auto" Margin="8,4" ToolTip.Tip="{Binding DisplayName}">
                    <TextBlock Text="{Binding DisplayName}" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" />
                    <TextBlock Grid.Column="1" Text="{Binding StatusText}" Classes="secondary" Margin="12,0,0,0" />
                  </Grid>
                </DataTemplate>
              </ListBox.ItemTemplate>
            </ListBox>
            <WrapPanel IsVisible="{Binding IsPairEmpty}">
              <Button Content="Try again" Command="{Binding FindPairDevicesCommand}"
                      Classes="primary" Margin="0,0,8,8" />
              <Button Content="Pair by address" Command="{Binding ShowPairAddressCommand}"
                      Classes="secondary" Margin="0,0,8,8" />
              <Button Content="Open Settings" Command="{Binding OpenSettingsRecoveryCommand}"
                      Classes="secondary" Margin="0,0,0,8" />
            </WrapPanel>
          </StackPanel>

          <StackPanel Spacing="10" IsVisible="{Binding IsPairReady}">
            <TextBlock Text="Scan this code in Glide on your phone to pair." Classes="h3" TextWrapping="Wrap" />
            <WrapPanel>
              <Border Background="White" Padding="10" CornerRadius="10" HorizontalAlignment="Left"
                      IsVisible="{Binding IsPairQrVisible}">
                <Image Source="{Binding PairQrImage}" Width="240" Height="240"
                       Stretch="Uniform" AutomationProperties.Name="Pair-only QR code for this computer" />
              </Border>
              <StackPanel Spacing="6" Margin="20,8,0,0" VerticalAlignment="Center" MaxWidth="260">
                <TextBlock Text="Pairing code for another computer" Classes="h3" TextWrapping="Wrap" />
                <TextBlock Text="{Binding Pairing.Code}" FontSize="32" FontWeight="Bold"
                           AutomationProperties.Name="Six-digit pairing code" />
                <TextBlock Text="{Binding Pairing.ExpiryText}" Classes="muted" />
              </StackPanel>
            </WrapPanel>
            <TextBlock Text="QR unavailable. Copy the link or get a new code." Classes="secondary"
                       TextWrapping="Wrap" IsVisible="{Binding IsPairQrUnavailable}" />
            <WrapPanel>
              <Button x:Name="CopyPairLinkButton" Content="Copy link" Classes="secondary" Margin="0,0,8,8" />
              <Button Content="New code" Command="{Binding ReadyToPairCommand}" Classes="secondary" Margin="0,0,8,8" />
              <Button Content="Cancel" Command="{Binding CancelPairCommand}" Classes="secondary" Margin="0,0,0,8" />
            </WrapPanel>
            <Expander Header="Connection details" IsExpanded="False" HorizontalAlignment="Stretch">
              <TextBlock Text="{Binding Pairing.Diagnostic, StringFormat='{}Local address: {0}'}"
                         Classes="secondary" TextWrapping="Wrap" Margin="0,6,0,0" />
            </Expander>
          </StackPanel>

          <StackPanel Spacing="10" IsVisible="{Binding IsPairPinEntry}">
            <TextBlock Text="{Binding Pairing.PeerName, StringFormat='{}Pair with {0}'}" Classes="h3"
                       TextTrimming="CharacterEllipsis" ToolTip.Tip="{Binding Pairing.PeerName}" />
            <TextBlock Text="Six-digit pairing code" Classes="secondary" />
            <TextBox Text="{Binding PairPin}" MaxLength="6" Width="180" HorizontalAlignment="Left"
                     PlaceholderText="000000" AutomationProperties.Name="Six-digit pairing code" />
            <WrapPanel>
              <Button Content="Pair" Command="{Binding SubmitPairPinCommand}" Classes="primary" Margin="0,0,8,8" />
              <Button Content="Cancel" Command="{Binding CancelPairCommand}" Classes="secondary" Margin="0,0,0,8" />
            </WrapPanel>
          </StackPanel>

          <StackPanel Spacing="10" IsVisible="{Binding IsPairManualEntry}">
            <TextBlock Text="Local address" Classes="h3" />
            <TextBox Text="{Binding PairAddress}" PlaceholderText="192.168.1.20:42424" MaxWidth="320" HorizontalAlignment="Left"
                     AutomationProperties.Name="Other computer local address and port" />
            <TextBlock Text="Six-digit pairing code" Classes="h3" />
            <TextBox Text="{Binding PairPin}" MaxLength="6" MaxWidth="320" Width="320" HorizontalAlignment="Left"
                     PlaceholderText="000000" AutomationProperties.Name="Six-digit pairing code" />
            <WrapPanel>
              <Button Content="Pair" Command="{Binding SubmitPairAddressCommand}"
                      Classes="primary" Margin="0,0,8,8" />
              <Button Content="Cancel" Command="{Binding CancelPairCommand}"
                      Classes="secondary" Margin="0,0,0,8" />
            </WrapPanel>
          </StackPanel>

          <StackPanel Spacing="10" IsVisible="{Binding IsPairLinkEntry}">
            <TextBlock Text="Enter another device's pairing link" Classes="h3" />
            <TextBox Text="{Binding PairLink}" PlaceholderText="glide://pair/v2#…"
                     AutomationProperties.Name="Pair-only invitation link" />
            <WrapPanel>
              <Button Content="Pair" Command="{Binding SubmitPairLinkCommand}"
                      Classes="primary" Margin="0,0,8,8" />
              <Button Content="Cancel" Command="{Binding CancelPairCommand}"
                      Classes="secondary" Margin="0,0,0,8" />
            </WrapPanel>
          </StackPanel>

          <StackPanel Spacing="10" IsVisible="{Binding IsPairApproval}">
            <TextBlock Text="{Binding Pairing.PeerName, StringFormat='{}{0} wants to pair'}" Classes="h3"
                       TextTrimming="CharacterEllipsis" ToolTip.Tip="{Binding Pairing.PeerName}" />
            <WrapPanel>
              <Button Content="Approve" Command="{Binding ApprovePairCommand}" Classes="primary" Margin="0,0,8,8" />
              <Button Content="Decline" Command="{Binding DeclinePairCommand}" Classes="secondary" Margin="0,0,0,8" />
            </WrapPanel>
          </StackPanel>

          <StackPanel Spacing="10" IsVisible="{Binding IsPairResult}">
            <TextBlock Text="{Binding Pairing.Message}" Classes="body" FontWeight="SemiBold" TextWrapping="Wrap" />
            <WrapPanel>
              <Button Content="{Binding Pairing.RecoveryAction}" Command="{Binding PairRecoveryCommand}"
                      IsVisible="{Binding IsPairFailed}" Classes="primary" Margin="0,0,8,8" />
              <Button Content="Done" Command="{Binding CancelPairCommand}"
                      IsVisible="{Binding IsPairSuccess}" Classes="secondary" Margin="0,0,0,8" />
            </WrapPanel>
            <Expander Header="Diagnostic details" IsVisible="{Binding IsPairFailed}" HorizontalAlignment="Stretch">
              <TextBlock Text="{Binding Pairing.Diagnostic}" Classes="muted"
                         FontFamily="{DynamicResource FontFamilyMonospace}" TextWrapping="Wrap" Margin="0,6,0,0" />
            </Expander>
          </StackPanel>

        </StackPanel>
      </Border>

      <Border Classes="card">
        <StackPanel Spacing="10">
          <TextBlock Text="Paired devices" Classes="h3" />
          <ItemsControl ItemsSource="{Binding TrustedPeers}" AutomationProperties.Name="Paired devices">
            <ItemsControl.ItemTemplate>
              <DataTemplate>
                <Grid ColumnDefinitions="*,Auto" Margin="0,4">
                  <TextBlock Grid.Column="0" Text="{Binding DisplayName}" ToolTip.Tip="{Binding DisplayName}"
                             TextTrimming="CharacterEllipsis" VerticalAlignment="Center" />
                  <Button Grid.Column="1" Content="Remove" Classes="secondary"
                          Command="{Binding $parent[ItemsControl].DataContext.RevokeTrustedPeerCommand}"
                          CommandParameter="{Binding}" Margin="12,0,0,0"
                          AutomationProperties.Name="Remove paired device" />
                </Grid>
              </DataTemplate>
            </ItemsControl.ItemTemplate>
          </ItemsControl>
        </StackPanel>
      </Border>
    </StackPanel>
  </ScrollViewer>
</UserControl>
