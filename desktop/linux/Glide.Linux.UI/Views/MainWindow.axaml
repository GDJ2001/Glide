<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="using:Glide.Linux.UI.ViewModels"
        xmlns:pages="using:Glide.Linux.UI.Views.Pages"
        xmlns:controls="using:Glide.Linux.UI.Views.Controls"
        x:Class="Glide.Linux.UI.Views.MainWindow"
        x:DataType="vm:LinuxMainViewModel"
        Title="Glide"
        Icon="avares://Glide.Linux.UI/Assets/glide-128.png"
        Width="1040" Height="720"
        MinWidth="760" MinHeight="520"
        WindowStartupLocation="CenterScreen"
        WindowDecorations="None"
        ExtendClientAreaToDecorationsHint="True"
        TransparencyLevelHint="Transparent"
        Background="Transparent"
        Foreground="{DynamicResource TextPrimaryBrush}"
        DragDrop.AllowDrop="True">

  <Border x:Name="WindowSurface"
          Background="{DynamicResource AppBackgroundBrush}"
          CornerRadius="12"
          ClipToBounds="True">
  <Grid RowDefinitions="36,*">
    <Border x:Name="GlideTitleBar" Grid.Row="0"
            Background="{DynamicResource AppBackgroundBrush}"
            BorderBrush="{DynamicResource BorderSubtleBrush}" BorderThickness="0,0,0,1"
            WindowDecorationProperties.ElementRole="TitleBar">
      <Grid ColumnDefinitions="*,Auto,*">
        <TextBlock Grid.Column="1" Text="Glide" VerticalAlignment="Center"
                   Foreground="{DynamicResource TextPrimaryBrush}" FontWeight="SemiBold"
                   IsHitTestVisible="False" />
        <StackPanel Grid.Column="2" Orientation="Horizontal" HorizontalAlignment="Right">
          <Button x:Name="MinimizeWindowButton" Classes="window-control"
                  WindowDecorationProperties.ElementRole="MinimizeButton"
                  Click="OnMinimizeWindow" AutomationProperties.Name="Minimize Glide">
            <Path Data="M 4,10 L 14,10" Stroke="{DynamicResource TextPrimaryBrush}" StrokeThickness="1.5" />
          </Button>
          <Button x:Name="MaximizeWindowButton" Classes="window-control"
                  WindowDecorationProperties.ElementRole="MaximizeButton"
                  Click="OnMaximizeWindow" AutomationProperties.Name="Maximize Glide">
            <Grid Width="16" Height="16">
              <Path x:Name="MaximizeWindowIcon" Data="M 4,4 L 12,4 L 12,12 L 4,12 Z"
                    Stroke="{DynamicResource TextPrimaryBrush}" StrokeThickness="1.5" />
              <Path x:Name="RestoreWindowIcon" Data="M 4,6 L 10,6 L 10,12 L 4,12 Z M 6,4 L 12,4 L 12,10"
                    Stroke="{DynamicResource TextPrimaryBrush}" StrokeThickness="1.5" IsVisible="False" />
            </Grid>
          </Button>
          <Button x:Name="CloseWindowButton" Classes="window-control window-close"
                  WindowDecorationProperties.ElementRole="CloseButton"
                  Click="OnCloseWindow" AutomationProperties.Name="Close Glide">
            <Path Data="M 4,4 L 12,12 M 12,4 L 4,12" Stroke="{DynamicResource TextPrimaryBrush}" StrokeThickness="1.5" />
          </Button>
        </StackPanel>
      </Grid>
    </Border>

  <Grid Grid.Row="1">
    <!-- Shell Layout: Left Nav Rail (212 DIP), Right Main Content -->
    <Grid ColumnDefinitions="212,*">

      <!-- LEFT NAVIGATION RAIL -->
      <Border Grid.Column="0" Background="{DynamicResource SidebarBrush}"
              BorderBrush="{DynamicResource BorderSubtleBrush}" BorderThickness="0,0,1,0">
        <Grid RowDefinitions="Auto,*,Auto,Auto">

          <!-- App Brand Header -->
          <StackPanel Grid.Row="0" Margin="20,20,20,16" Spacing="8">
            <Image Source="{DynamicResource GlideLogoHorizontal}"
                   Width="124"
                   Stretch="Uniform"
                   HorizontalAlignment="Left"
                   VerticalAlignment="Center"
                   AutomationProperties.Name="Glide" />
            <TextBlock Text="Peer-to-Peer Local Sharing" Classes="muted" />
          </StackPanel>

          <!-- Top Navigation Destinations (LUI-02: real selected styles) -->
          <StackPanel Grid.Row="1" Margin="12,0" Spacing="4">
            <Button Content="Send"
                    Command="{Binding SwitchTabCommand}" CommandParameter="Send"
                    Classes="nav" Classes.selected="{Binding IsSendActive}"
                    AutomationProperties.Name="Send navigation destination">
              <StackPanel Orientation="Horizontal" Spacing="12">
                <PathIcon Data="{StaticResource IconSend}" Width="16" Height="16" />
                <TextBlock Text="Send" VerticalAlignment="Center" />
              </StackPanel>
            </Button>

            <Button Content="Receive"
                    Command="{Binding SwitchTabCommand}" CommandParameter="Receive"
                    Classes="nav" Classes.selected="{Binding IsReceiveActive}"
                    AutomationProperties.Name="Receive navigation destination">
              <StackPanel Orientation="Horizontal" Spacing="12">
                <PathIcon Data="{StaticResource IconReceive}" Width="16" Height="16" />
                <TextBlock Text="Receive" VerticalAlignment="Center" />
              </StackPanel>
            </Button>

            <Button Content="Activity"
                    Command="{Binding SwitchTabCommand}" CommandParameter="Activity"
                    Classes="nav" Classes.selected="{Binding IsActivityActive}"
                    AutomationProperties.Name="Transfer activity navigation destination">
              <StackPanel Orientation="Horizontal" Spacing="12">
                <PathIcon Data="{StaticResource IconActivity}" Width="16" Height="16" />
                <TextBlock Text="Activity" VerticalAlignment="Center" />
              </StackPanel>
            </Button>

            <Button Content="Pair"
                    Command="{Binding SwitchTabCommand}" CommandParameter="Pair"
                    Classes="nav" Classes.selected="{Binding IsPairActive}"
                    AutomationProperties.Name="Pair devices navigation destination">
              <StackPanel Orientation="Horizontal" Spacing="12">
                <PathIcon Data="{StaticResource IconPair}" Width="16" Height="16" />
                <TextBlock Text="Pair devices" VerticalAlignment="Center" />
              </StackPanel>
            </Button>
          </StackPanel>

          <!-- Bottom Navigation: Settings (anchored at bottom) -->
          <StackPanel Grid.Row="2" Margin="12,0,12,12">
            <Button Content="Settings"
                    Command="{Binding SwitchTabCommand}" CommandParameter="Settings"
                    Classes="nav" Classes.selected="{Binding IsSettingsActive}"
                    AutomationProperties.Name="Settings navigation destination">
              <StackPanel Orientation="Horizontal" Spacing="12">
                <PathIcon Data="{StaticResource IconSettings}" Width="16" Height="16" />
                <TextBlock Text="Settings" VerticalAlignment="Center" />
              </StackPanel>
            </Button>
          </StackPanel>

          <!-- Sidebar Receiving Status Card (LUI-03) -->
          <Border Grid.Row="3" Margin="12,0,12,16" Padding="12"
                  Background="{DynamicResource SurfaceRaisedBrush}" CornerRadius="8">
            <StackPanel Spacing="6">
              <StackPanel Orientation="Horizontal" Spacing="8">
                <Ellipse Classes="status-dot" Classes.active="{Binding IsListening}" VerticalAlignment="Center" />
                <TextBlock Text="{Binding ReceivingStatusText}" Classes="small" FontWeight="SemiBold"
                           VerticalAlignment="Center" />
              </StackPanel>
              <TextBlock Text="{Binding StatusMessage}" Classes="muted"
                         TextWrapping="Wrap" MaxLines="3" TextTrimming="CharacterEllipsis"
                         ToolTip.Tip="{Binding StatusMessage}" />
            </StackPanel>
          </Border>

        </Grid>
      </Border>

      <!-- RIGHT MAIN CONTENT (LUI-01: Exactly one page visible) -->
      <Grid Grid.Column="1" Margin="32,28,32,24">
        <!-- Send Page -->
        <pages:SendPage IsVisible="{Binding IsSendActive}" />

        <!-- Receive Page -->
        <pages:ReceivePage IsVisible="{Binding IsReceiveActive}" />

        <!-- Pair Page -->
        <pages:PairPage IsVisible="{Binding IsPairActive}" />

        <!-- Activity Page -->
        <pages:ActivityPage IsVisible="{Binding IsActivityActive}" />

        <!-- Settings Page -->
        <pages:SettingsPage IsVisible="{Binding IsSettingsActive}" />

        <!-- Persistent Active Transfer Banner across navigation (LUI-08) -->
        <controls:ActiveTransferBanner VerticalAlignment="Bottom" />
      </Grid>

    </Grid>

    <!-- ACCESSIBLE MODAL HOST OVERLAY (LUI-08) -->
    <controls:ModalHost />

  </Grid>
  </Grid>
  </Border>
</Window>
