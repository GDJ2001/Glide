[Desktop Entry]
Name=Glide
Comment=High-Speed Zero-Cloud Local File Sharing
Exec=glide-desktop %F
Icon=/usr/share/icons/hicolor/128x128/apps/dev.glide.app.png
StartupWMClass=glide-desktop
Terminal=false
Type=Application
Categories=Network;FileTransfer;Utility;
MimeType=all/allfiles;
Actions=Receive;

[Desktop Action Receive]
Name=Receive Files
Exec=glide receive
