<Window x:Class="Glide.Windows.UI.Views.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:vm="clr-namespace:Glide.Windows.UI.ViewModels"
        mc:Ignorable="d"
        Title="Glide — Local sharing" Height="720" Width="1040" MinWidth="500" MinHeight="480"
        SizeChanged="Window_SizeChanged"
        WindowStartupLocation="CenterScreen" Icon="pack://application:,,,/Glide;component/glide.ico"
        Background="{DynamicResource AppBackgroundBrush}" Foreground="{DynamicResource TextPrimaryBrush}">
    <Window.DataContext>
        <vm:MainViewModel />
    </Window.DataContext>

    <Grid KeyboardNavigation.TabNavigation="Cycle">
        <Grid.ColumnDefinitions>
            <ColumnDefinition x:Name="SidebarColumn" Width="212" />
            <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>

        <Border x:Name="Sidebar" Grid.Column="0" Background="{DynamicResource SidebarBrush}" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="0,0,1,0" Padding="16,20">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>

                <StackPanel>
                    <StackPanel Orientation="Horizontal" Margin="8,0,0,28">
                        <Image x:Name="BrandSymbol" Source="/Glide;component/Assets/glide-symbol-blue-96.png" Width="30" Height="30" Stretch="Uniform" Margin="0,0,10,0" />
                        <StackPanel x:Name="BrandName">
                            <TextBlock Text="Glide" FontSize="18" FontWeight="Bold" Foreground="{DynamicResource TextPrimaryBrush}" />
                            <TextBlock Text="Local sharing" FontSize="11" Foreground="{DynamicResource TextSecondaryBrush}" />
                        </StackPanel>
                    </StackPanel>

                    <RadioButton x:Name="NavSend" Style="{StaticResource NavButtonStyle}" GroupName="Navigation" IsChecked="{Binding IsSendSelected, Mode=OneWay}" Command="{Binding SwitchTabCommand}" CommandParameter="Send" AutomationProperties.Name="Send files" ToolTip="Send">
                        <StackPanel Orientation="Horizontal"><Path x:Name="NavSendIcon" Data="{StaticResource IconSend}" Fill="{Binding Foreground, RelativeSource={RelativeSource AncestorType=RadioButton}}" Stretch="Uniform" Width="20" Height="20" Margin="0,0,12,0" /><TextBlock x:Name="NavSendLabel" Text="Send" VerticalAlignment="Center" /></StackPanel>
                    </RadioButton>
                    <RadioButton x:Name="NavReceive" Style="{StaticResource NavButtonStyle}" GroupName="Navigation" IsChecked="{Binding IsReceiveSelected, Mode=OneWay}" Command="{Binding SwitchTabCommand}" CommandParameter="Receive" AutomationProperties.Name="Receive files" ToolTip="Receive">
                        <StackPanel Orientation="Horizontal"><Path x:Name="NavReceiveIcon" Data="{StaticResource IconReceive}" Fill="{Binding Foreground, RelativeSource={RelativeSource AncestorType=RadioButton}}" Stretch="Uniform" Width="20" Height="20" Margin="0,0,12,0" /><TextBlock x:Name="NavReceiveLabel" Text="Receive" VerticalAlignment="Center" /></StackPanel>
                    </RadioButton>
                    <RadioButton x:Name="NavActivity" Style="{StaticResource NavButtonStyle}" GroupName="Navigation" IsChecked="{Binding IsActivitySelected, Mode=OneWay}" Command="{Binding SwitchTabCommand}" CommandParameter="Activity" AutomationProperties.Name="Transfer activity" ToolTip="Activity">
                        <StackPanel Orientation="Horizontal"><Path x:Name="NavActivityIcon" Data="{StaticResource IconActivity}" Fill="{Binding Foreground, RelativeSource={RelativeSource AncestorType=RadioButton}}" Stretch="Uniform" Width="20" Height="20" Margin="0,0,12,0" /><TextBlock x:Name="NavActivityLabel" Text="Activity" VerticalAlignment="Center" /></StackPanel>
                    </RadioButton>
                    <RadioButton x:Name="NavPairDevices" Style="{StaticResource NavButtonStyle}" GroupName="Navigation" IsChecked="{Binding IsPairDevicesSelected, Mode=OneWay}" Command="{Binding SwitchTabCommand}" CommandParameter="Pair devices" AutomationProperties.Name="Pair devices" ToolTip="Pair devices">
                        <StackPanel Orientation="Horizontal"><Path x:Name="NavPairDevicesIcon" Data="{StaticResource IconPhone}" Fill="{Binding Foreground, RelativeSource={RelativeSource AncestorType=RadioButton}}" Stretch="Uniform" Width="20" Height="20" Margin="0,0,12,0" /><TextBlock x:Name="NavPairDevicesLabel" Text="Pair devices" VerticalAlignment="Center" /></StackPanel>
                    </RadioButton>
                </StackPanel>

                <StackPanel Grid.Row="2">
                    <Border x:Name="LocalSharingNote" Background="{DynamicResource SurfaceRaisedBrush}" CornerRadius="8" Padding="12" Margin="0,0,0,12">
                        <StackPanel>
                            <TextBlock Text="Sharing is local" FontWeight="SemiBold" FontSize="12" />
                            <TextBlock Text="Files stay on your network. You approve every new connection." TextWrapping="Wrap" FontSize="11" Foreground="{DynamicResource TextSecondaryBrush}" Margin="0,4,0,0" />
                        </StackPanel>
                    </Border>
                    <RadioButton x:Name="NavSettings" Style="{StaticResource NavButtonStyle}" GroupName="Navigation" IsChecked="{Binding IsSettingsSelected, Mode=OneWay}" Command="{Binding SwitchTabCommand}" CommandParameter="Settings" AutomationProperties.Name="Settings" ToolTip="Settings">
                        <StackPanel Orientation="Horizontal"><Path x:Name="NavSettingsIcon" Data="{StaticResource IconSettings}" Fill="{Binding Foreground, RelativeSource={RelativeSource AncestorType=RadioButton}}" Stretch="Uniform" Width="20" Height="20" Margin="0,0,12,0" /><TextBlock x:Name="NavSettingsLabel" Text="Settings" VerticalAlignment="Center" /></StackPanel>
                    </RadioButton>
                </StackPanel>
            </Grid>
        </Border>

        <Grid x:Name="MainContent" Grid.Column="1" Margin="32,28,32,24">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <Grid>
                <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                <StackPanel Grid.Column="0" Margin="0,0,12,0">
                    <TextBlock Text="{Binding CurrentTab}" FontSize="26" FontWeight="SemiBold" />
                    <TextBlock Text="{Binding StatusMessage}" Foreground="{DynamicResource TextSecondaryBrush}" Margin="0,4,0,0" TextTrimming="CharacterEllipsis" />
                </StackPanel>
                <Button Grid.Column="1" Style="{StaticResource SecondaryButtonStyle}" Command="{Binding OpenDownloadsCommand}" HorizontalAlignment="Right" AutomationProperties.Name="Open received files folder">
                    <StackPanel Orientation="Horizontal"><Path Data="{StaticResource IconFolderOpen}" Fill="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}" Stretch="Uniform" Width="18" Height="18" Margin="0,0,8,0" /><TextBlock Text="Received files" /></StackPanel>
                </Button>
            </Grid>

            <Grid Grid.Row="1" Margin="0,28,0,0">
                <!-- Send -->
                <ScrollViewer x:Name="SendPage" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" Visibility="{Binding IsSendSelected, Converter={StaticResource BoolToVis}}">
                    <StackPanel>
                        <Border x:Name="SendDropZone" AllowDrop="True" Drop="DropZone_Drop" DragOver="DropZone_DragOver" SizeChanged="SendDropZone_SizeChanged" AutomationProperties.Name="Files to send drop area">
                            <Border.Style>
                                <Style TargetType="Border" BasedOn="{StaticResource CardStyle}">
                                    <Setter Property="BorderBrush" Value="{DynamicResource PrimaryBrush}" />
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding HasSelectedFiles}" Value="True">
                                            <Setter Property="BorderBrush" Value="{DynamicResource BorderBrush}" />
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </Border.Style>
                            <Grid>
                                <StackPanel x:Name="EmptyFileState" HorizontalAlignment="Center" Margin="0,8">
                                    <StackPanel.Style>
                                        <Style TargetType="StackPanel">
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding HasSelectedFiles}" Value="True"><Setter Property="Visibility" Value="Collapsed" /></DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </StackPanel.Style>
                                    <Path Data="{StaticResource IconDocumentAdd}" Fill="{DynamicResource PrimaryBrush}" Stretch="Uniform" Width="32" Height="32" HorizontalAlignment="Center" />
                                    <TextBlock Text="Drop files or folders here" FontSize="16" FontWeight="SemiBold" HorizontalAlignment="Center" Margin="0,10,0,4" />
                                    <TextBlock Text="Or choose what to share from your computer" Foreground="{DynamicResource TextSecondaryBrush}" HorizontalAlignment="Center" />
                                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" Margin="0,16,0,0">
                                        <Button x:Name="EmptyAddFilesButton" Style="{StaticResource PrimaryButtonStyle}" Command="{Binding AddFilesCommand}" Margin="0,0,8,0" MinWidth="116" AutomationProperties.Name="Add files to send"><StackPanel Orientation="Horizontal"><Path Data="{StaticResource IconDocumentAdd}" Fill="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}" Width="18" Height="18" Stretch="Uniform" Margin="0,0,8,0" /><TextBlock Text="Add files" VerticalAlignment="Center" /></StackPanel></Button>
                                        <Button Style="{StaticResource SecondaryButtonStyle}" Command="{Binding AddFolderCommand}" MinWidth="116" AutomationProperties.Name="Add folder to send"><StackPanel Orientation="Horizontal"><Path Data="{StaticResource IconFolderAdd}" Fill="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}" Width="18" Height="18" Stretch="Uniform" Margin="0,0,8,0" /><TextBlock Text="Add folder" VerticalAlignment="Center" /></StackPanel></Button>
                                    </StackPanel>
                                </StackPanel>

                                <Grid x:Name="SelectedFileState" Visibility="{Binding HasSelectedFiles, Converter={StaticResource BoolToVis}}">
                                    <Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="Auto" /><RowDefinition Height="Auto" /></Grid.RowDefinitions>
                                    <Grid x:Name="SelectedFileHeader">
                                        <Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="Auto" /></Grid.RowDefinitions>
                                        <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                                        <StackPanel Margin="0,0,12,0" VerticalAlignment="Center">
                                            <TextBlock Text="Files to send" FontWeight="SemiBold" FontSize="16" />
                                            <TextBlock Text="{Binding SelectedFilesSummary}" Foreground="{DynamicResource TextSecondaryBrush}" FontSize="12" Margin="0,3,0,0" TextWrapping="Wrap" AutomationProperties.LiveSetting="Polite" />
                                        </StackPanel>
                                        <StackPanel x:Name="SelectedFileActions" Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                                            <Button Style="{StaticResource SecondaryButtonStyle}" Content="Add files" Command="{Binding AddFilesCommand}" AutomationProperties.Name="Add more files to send" Margin="0,0,8,0" />
                                            <Button Style="{StaticResource SecondaryButtonStyle}" Content="Add folder" Command="{Binding AddFolderCommand}" AutomationProperties.Name="Add another folder to send" Margin="0,0,8,0" />
                                            <Button Style="{StaticResource SecondaryButtonStyle}" Content="Clear list" Command="{Binding ClearFilesCommand}" AutomationProperties.Name="Clear selected files" />
                                        </StackPanel>
                                    </Grid>
                                    <ListBox x:Name="SelectedFilesList" Grid.Row="1" ItemsSource="{Binding SelectedFiles}" BorderThickness="0" Background="Transparent" Margin="0,12,0,0" MaxHeight="220" HorizontalContentAlignment="Stretch" ScrollViewer.HorizontalScrollBarVisibility="Disabled" ScrollViewer.CanContentScroll="True" VirtualizingPanel.IsVirtualizing="True">
                                        <ListBox.ItemTemplate>
                                            <DataTemplate>
                                                <Grid Margin="0,4">
                                                    <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="100" /><ColumnDefinition Width="80" /></Grid.ColumnDefinitions>
                                                    <StackPanel>
                                                        <TextBlock Text="{Binding Name}" Foreground="{DynamicResource TextPrimaryBrush}" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" ToolTip="{Binding Name}" />
                                                        <TextBlock Text="{Binding Status}" Foreground="{DynamicResource TextSecondaryBrush}" FontSize="11" />
                                                    </StackPanel>
                                                    <TextBlock Grid.Column="1" Text="{Binding FormattedSize}" Foreground="{DynamicResource TextSecondaryBrush}" VerticalAlignment="Center" HorizontalAlignment="Right" Margin="8,0" />
                                                    <Button Grid.Column="2" Style="{StaticResource SecondaryButtonStyle}" Content="Remove" Command="{Binding DataContext.RemoveFileCommand, RelativeSource={RelativeSource AncestorType=ListBox}}" CommandParameter="{Binding}" VerticalAlignment="Center" Width="76" Padding="10,4" MinHeight="32" AutomationProperties.Name="Remove queued file" />
                                                </Grid>
                                            </DataTemplate>
                                        </ListBox.ItemTemplate>
                                    </ListBox>
                                    <TextBlock Grid.Row="2" Text="Drop more files or folders anywhere in this card." Foreground="{DynamicResource TextSecondaryBrush}" FontSize="11" Margin="0,8,0,0" />
                                </Grid>
                            </Grid>
                        </Border>

                        <Border Style="{StaticResource CardStyle}" Margin="0,16,0,0">
                            <StackPanel>
                                <TextBlock Text="Choose a device" FontWeight="SemiBold" FontSize="16" />
                                <TextBlock Text="Select one way to send these files." Foreground="{DynamicResource TextSecondaryBrush}" FontSize="12" Margin="0,4,0,14" />
                                <RadioButton Style="{StaticResource SendMethodCardStyle}" GroupName="SendMethod" IsChecked="{Binding IsQuickQrSelected, Mode=OneWay}" IsEnabled="{Binding HasSelectedFiles}" Command="{Binding SelectSendMethodCommand}" CommandParameter="QuickQr" AutomationProperties.Name="Quick share with QR code" Margin="0,0,0,8">
                                    <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="Auto" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions><Path Data="{StaticResource IconPhone}" Fill="{DynamicResource PrimaryBrush}" Width="22" Height="22" Stretch="Uniform" VerticalAlignment="Center" Margin="0,0,12,0" /><StackPanel Grid.Column="1"><TextBlock Text="Quick share with QR" Foreground="{DynamicResource TextPrimaryBrush}" FontWeight="SemiBold" /><TextBlock Text="Show a code now. Sending starts after scan and your approval." Foreground="{DynamicResource TextSecondaryBrush}" FontSize="12" TextWrapping="Wrap" /></StackPanel></Grid>
                                </RadioButton>
                                <RadioButton Style="{StaticResource SendMethodCardStyle}" GroupName="SendMethod" IsChecked="{Binding IsTrustedSelected, Mode=OneWay}" IsEnabled="{Binding HasSelectedFiles}" Command="{Binding SelectSendMethodCommand}" CommandParameter="Trusted" AutomationProperties.Name="Paired device">
                                    <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="Auto" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions><Path Data="{StaticResource IconActivity}" Fill="{DynamicResource PrimaryBrush}" Width="22" Height="22" Stretch="Uniform" VerticalAlignment="Center" Margin="0,0,12,0" /><StackPanel Grid.Column="1"><TextBlock Text="Paired device" Foreground="{DynamicResource TextPrimaryBrush}" FontWeight="SemiBold" /><TextBlock Text="Choose a paired device to send." Foreground="{DynamicResource TextSecondaryBrush}" FontSize="12" TextWrapping="Wrap" /></StackPanel></Grid>
                                </RadioButton>
                                <TextBlock Text="{Binding SelectedSendMethodText}" Foreground="{DynamicResource TextSecondaryBrush}" TextWrapping="Wrap" Margin="0,14,0,0" AutomationProperties.LiveSetting="Polite" />
                                <Button x:Name="SendChosenDeviceButton" Style="{StaticResource PrimaryButtonStyle}" Content="{Binding SendActionText}" Command="{Binding SendFilesCommand}" Visibility="{Binding IsSendActionVisible, Converter={StaticResource BoolToVis}}" HorizontalAlignment="Right" Margin="0,14,0,0" AutomationProperties.Name="Send selected files to chosen device" />
                            </StackPanel>
                        </Border>
                    </StackPanel>
                </ScrollViewer>

                <!-- Pair devices -->
                <ScrollViewer x:Name="PairDevicesPage" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" Visibility="{Binding IsPairDevicesSelected, Converter={StaticResource BoolToVis}}">
                    <StackPanel>
                        <Border Style="{StaticResource CardStyle}">
                            <StackPanel>
                                <TextBlock Text="Pair devices" FontSize="20" FontWeight="SemiBold" Margin="0,0,0,12" />
                                <WrapPanel x:Name="PairMethodActions">
                                    <Button Style="{StaticResource PrimaryButtonStyle}" Content="Find devices" Command="{Binding FindPairDevicesCommand}" Margin="0,0,8,8" AutomationProperties.Name="Find pair-ready Glide devices" />
                                    <Button Style="{StaticResource SecondaryButtonStyle}" Content="Ready to pair" Command="{Binding ReadyToPairCommand}" Margin="0,0,8,8" AutomationProperties.Name="Show pairing code for this PC" />
                                    <Button Style="{StaticResource SecondaryButtonStyle}" Content="Use QR or link" Command="{Binding ShowPairLinkCommand}" Margin="0,0,8,8" />
                                    <Button Style="{StaticResource SecondaryButtonStyle}" Content="Pair by address" Command="{Binding ShowPairAddressCommand}" Margin="0,0,0,8" />
                                </WrapPanel>
                                <StackPanel Visibility="{Binding IsPairDiscovery, Converter={StaticResource BoolToVis}}" Margin="0,12,0,0">
                                    <TextBlock Text="{Binding Pairing.Message}" Foreground="{DynamicResource TextSecondaryBrush}" TextWrapping="Wrap" AutomationProperties.LiveSetting="Polite" />
                                    <ItemsControl ItemsSource="{Binding DiscoveredPeers}" Margin="0,10,0,0">
                                        <ItemsControl.ItemTemplate><DataTemplate>
                                            <Button Style="{StaticResource SecondaryButtonStyle}" Command="{Binding DataContext.SelectPairPeerCommand, RelativeSource={RelativeSource AncestorType=Window}}" CommandParameter="{Binding}" IsEnabled="{Binding IsPairReady}" HorizontalAlignment="Stretch" HorizontalContentAlignment="Stretch" Margin="0,0,0,8" ToolTip="{Binding DeviceName}" AutomationProperties.Name="Select pair-ready device">
                                                <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions><TextBlock Text="{Binding DeviceName}" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" ToolTip="{Binding DeviceName}" /><TextBlock Grid.Column="1" Text="{Binding CapabilitiesText}" Foreground="{DynamicResource TextSecondaryBrush}" Margin="12,0,0,0" /></Grid>
                                            </Button>
                                        </DataTemplate></ItemsControl.ItemTemplate>
                                    </ItemsControl>
                                    <Button Style="{StaticResource SecondaryButtonStyle}" Content="Try again" Command="{Binding FindPairDevicesCommand}" Visibility="{Binding IsPairEmpty, Converter={StaticResource BoolToVis}}" HorizontalAlignment="Left" Margin="0,8,0,0" />
                                </StackPanel>
                                <StackPanel Visibility="{Binding IsPairReady, Converter={StaticResource BoolToVis}}" Margin="0,12,0,0">
                                    <TextBlock Text="Pairing code" FontWeight="SemiBold" />
                                    <TextBlock Text="{Binding Pairing.Code}" FontSize="32" FontWeight="Bold" Margin="0,6,0,0" AutomationProperties.Name="Six-digit pairing code" />
                                    <TextBlock Text="{Binding Pairing.ExpiryText}" Foreground="{DynamicResource TextSecondaryBrush}" AutomationProperties.LiveSetting="Polite" />
                                    <TextBlock Text="Enter this code on the other computer." Foreground="{DynamicResource TextSecondaryBrush}" Margin="0,6,0,0" TextWrapping="Wrap" />
                                    <Border Background="White" CornerRadius="10" Padding="10" HorizontalAlignment="Left" Margin="0,12,0,0" Visibility="{Binding IsPairQrVisible, Converter={StaticResource BoolToVis}}"><Image Source="{Binding PairOnlyQrImage}" Width="200" Height="200" Stretch="Uniform" RenderOptions.BitmapScalingMode="NearestNeighbor" AutomationProperties.Name="Pair-only QR code" /></Border>
                                    <WrapPanel Margin="0,12,0,0">
                                        <Button Style="{StaticResource SecondaryButtonStyle}" Content="Show QR" Command="{Binding ShowPairQrCommand}" Margin="0,0,8,8" />
                                        <Button Style="{StaticResource SecondaryButtonStyle}" Content="Copy link" Command="{Binding CopyPairOnlyLinkCommand}" Margin="0,0,8,8" />
                                        <Button Style="{StaticResource SecondaryButtonStyle}" Content="Cancel" Command="{Binding CancelPairCommand}" Margin="0,0,0,8" />
                                    </WrapPanel>
                                    <Expander Header="Connection details" Margin="0,8,0,0">
                                        <TextBlock Text="{Binding Pairing.Diagnostic, StringFormat='Local address: {0}'}" Foreground="{DynamicResource TextSecondaryBrush}" TextWrapping="Wrap" Margin="0,6,0,0" />
                                    </Expander>
                                </StackPanel>
                                <StackPanel Visibility="{Binding IsPairPinEntry, Converter={StaticResource BoolToVis}}" Margin="0,12,0,0">
                                    <TextBlock Text="{Binding Pairing.PeerName, StringFormat='Pair with {0}'}" FontWeight="SemiBold" FontSize="16" TextTrimming="CharacterEllipsis" ToolTip="{Binding Pairing.PeerName}" />
                                    <TextBlock Text="Six-digit pairing code" Foreground="{DynamicResource TextSecondaryBrush}" Margin="0,8,0,6" />
                                    <TextBox Style="{StaticResource ModernTextBoxStyle}" Text="{Binding PairPin, UpdateSourceTrigger=PropertyChanged}" MaxLength="6" Width="180" HorizontalAlignment="Left" AutomationProperties.Name="Six-digit pairing code" />
                                    <WrapPanel Margin="0,12,0,0"><Button Style="{StaticResource PrimaryButtonStyle}" Content="Pair" Command="{Binding SubmitPairPinCommand}" Margin="0,0,8,8" /><Button Style="{StaticResource SecondaryButtonStyle}" Content="Cancel" Command="{Binding CancelPairCommand}" Margin="0,0,0,8" /></WrapPanel>
                                </StackPanel>
                                <StackPanel Visibility="{Binding IsPairManualEntry, Converter={StaticResource BoolToVis}}" Margin="0,12,0,0">
                                    <TextBlock Text="Local address" FontWeight="SemiBold" />
                                    <TextBox x:Name="PairManualAddressInput" Style="{StaticResource ModernTextBoxStyle}" Text="{Binding PairAddress, UpdateSourceTrigger=PropertyChanged}" MaxWidth="320" Height="40" HorizontalAlignment="Stretch" Margin="0,6,0,8" ToolTip="{Binding PairAddress}" AutomationProperties.Name="Other computer local IP address and port" />
                                    <TextBlock Text="Six-digit pairing code" FontWeight="SemiBold" />
                                    <TextBox x:Name="PairManualPinInput" Style="{StaticResource ModernTextBoxStyle}" Text="{Binding PairPin, UpdateSourceTrigger=PropertyChanged}" MaxLength="6" MaxWidth="320" Height="40" HorizontalAlignment="Stretch" Margin="0,6,0,0" AutomationProperties.Name="Six-digit pairing code" />
                                    <WrapPanel Margin="0,12,0,0"><Button Style="{StaticResource PrimaryButtonStyle}" Content="Pair" Command="{Binding SubmitPairAddressCommand}" Margin="0,0,8,8" /><Button Style="{StaticResource SecondaryButtonStyle}" Content="Cancel" Command="{Binding CancelPairCommand}" Margin="0,0,0,8" /></WrapPanel>
                                </StackPanel>
                                <StackPanel Visibility="{Binding IsPairLinkEntry, Converter={StaticResource BoolToVis}}" Margin="0,12,0,0">
                                    <TextBlock Text="Use QR or link" FontWeight="SemiBold" />
                                    <TextBox Style="{StaticResource ModernTextBoxStyle}" Text="{Binding PairOnlyLink, UpdateSourceTrigger=PropertyChanged}" Margin="0,8,0,8" AutomationProperties.Name="Pair-only invitation link" />
                                    <WrapPanel><Button Style="{StaticResource PrimaryButtonStyle}" Content="Pair" Command="{Binding SubmitPairLinkCommand}" Margin="0,0,8,8" /><Button Style="{StaticResource SecondaryButtonStyle}" Content="Cancel" Command="{Binding CancelPairCommand}" Margin="0,0,0,8" /></WrapPanel>
                                </StackPanel>
                                <StackPanel Visibility="{Binding IsPairApproval, Converter={StaticResource BoolToVis}}" Margin="0,12,0,0">
                                    <TextBlock Text="{Binding Pairing.PeerName, StringFormat='{}{0} wants to pair'}" FontWeight="SemiBold" FontSize="18" TextTrimming="CharacterEllipsis" ToolTip="{Binding Pairing.PeerName}" AutomationProperties.LiveSetting="Polite" />
                                    <WrapPanel Margin="0,12,0,0"><Button Style="{StaticResource PrimaryButtonStyle}" Content="Approve" Command="{Binding ApprovePairCommand}" Margin="0,0,8,8" /><Button Style="{StaticResource SecondaryButtonStyle}" Content="Decline" Command="{Binding DeclinePairCommand}" Margin="0,0,0,8" /></WrapPanel>
                                </StackPanel>
                                <StackPanel Visibility="{Binding IsPairResult, Converter={StaticResource BoolToVis}}" Margin="0,12,0,0">
                                    <TextBlock Text="{Binding Pairing.Message}" FontWeight="SemiBold" TextWrapping="Wrap" AutomationProperties.LiveSetting="Polite" />
                                    <WrapPanel Margin="0,12,0,0">
                                        <Button Style="{StaticResource PrimaryButtonStyle}" Content="{Binding Pairing.RecoveryAction}" Command="{Binding PairRecoveryCommand}" Visibility="{Binding IsPairFailed, Converter={StaticResource BoolToVis}}" Margin="0,0,8,8" />
                                        <Button Style="{StaticResource SecondaryButtonStyle}" Content="Done" Command="{Binding CancelPairCommand}" Visibility="{Binding IsPairSuccess, Converter={StaticResource BoolToVis}}" Margin="0,0,0,8" />
                                    </WrapPanel>
                                    <Expander Header="Diagnostic details" Visibility="{Binding IsPairFailed, Converter={StaticResource BoolToVis}}" Margin="0,8,0,0">
                                        <TextBlock Text="{Binding Pairing.Diagnostic}" Foreground="{DynamicResource TextSecondaryBrush}" FontFamily="Consolas" FontSize="11" TextWrapping="Wrap" Margin="0,6,0,0" />
                                    </Expander>
                                </StackPanel>
                            </StackPanel>
                        </Border>
                        <Border Style="{StaticResource CardStyle}" Margin="0,16,0,0"><StackPanel><TextBlock Text="Paired devices" FontWeight="SemiBold" FontSize="16" /><ItemsControl ItemsSource="{Binding TrustedDevices}" Margin="0,10,0,0"><ItemsControl.ItemTemplate><DataTemplate><TextBlock Text="{Binding DisplayName}" ToolTip="{Binding DisplayName}" TextTrimming="CharacterEllipsis" Margin="0,4,0,4" /></DataTemplate></ItemsControl.ItemTemplate></ItemsControl></StackPanel></Border>
                    </StackPanel>
                </ScrollViewer>
                <!-- Receive -->
                <ScrollViewer x:Name="ReceivePage" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" Visibility="{Binding IsReceiveSelected, Converter={StaticResource BoolToVis}}">
                    <StackPanel>
                        <TextBlock Text="Make this PC available to nearby Glide devices. You approve each incoming transfer." Foreground="{DynamicResource TextSecondaryBrush}" Margin="0,0,0,20" TextWrapping="Wrap" />
                        <Border Style="{StaticResource CardStyle}">
                            <StackPanel>
                                <StackPanel>
                                    <TextBlock Text="{Binding ReceiveStatusTitle}" FontSize="18" FontWeight="SemiBold" />
                                    <TextBlock Text="Nearby devices can scan your one-time QR code. You will still review every offer." Foreground="{DynamicResource TextSecondaryBrush}" Margin="0,6,0,0" TextWrapping="Wrap" />
                                </StackPanel>
                                <Button x:Name="ReceiveControlButton" Style="{StaticResource PrimaryButtonStyle}" Content="{Binding ReceiveActionText}" Command="{Binding ToggleListenerCommand}" HorizontalAlignment="Left" Margin="0,14,0,0" />
                            </StackPanel>
                        </Border>
                        <Border Style="{StaticResource CardStyle}" Margin="0,16,0,0">
                            <StackPanel>
                                <TextBlock Text="Connect a phone" FontWeight="SemiBold" />
                                <TextBlock Text="Open Glide on the phone, choose Send files, then scan this code." Foreground="{DynamicResource TextSecondaryBrush}" FontSize="12" Margin="0,4,0,14" />
                                <StackPanel x:Name="ReceiveQrLayout" Orientation="Horizontal">
                                    <Border Background="White" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1" CornerRadius="10" Padding="10">
                                        <Image Source="{Binding PairingQrImage}" Width="180" Height="180" Stretch="Uniform" RenderOptions.BitmapScalingMode="NearestNeighbor" AutomationProperties.Name="QR code for receiving files" />
                                    </Border>
                                    <StackPanel x:Name="ReceiveQrActions" Margin="20,4,0,0" VerticalAlignment="Center">
                                        <Button x:Name="ReceiveShowQrButton" Style="{StaticResource PrimaryButtonStyle}" Content="Show larger code" Command="{Binding ToggleQrZoomCommand}" Width="192" HorizontalAlignment="Left" Margin="0,0,0,8" />
                                        <Button x:Name="ReceiveCopyLinkButton" Style="{StaticResource SecondaryButtonStyle}" Content="Copy receive link" Command="{Binding CopyPairingLinkCommand}" Width="192" HorizontalAlignment="Left" Margin="0,0,0,8" />
                                        <Button x:Name="ReceiveRefreshQrButton" Style="{StaticResource SecondaryButtonStyle}" Content="Refresh code" Command="{Binding RefreshQrCommand}" Width="192" HorizontalAlignment="Left" />
                                    </StackPanel>
                                </StackPanel>
                            </StackPanel>
                        </Border>
                    </StackPanel>
                </ScrollViewer>

                <!-- Activity -->
                <ScrollViewer x:Name="ActivityPage" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" Visibility="{Binding IsActivitySelected, Converter={StaticResource BoolToVis}}">
                    <StackPanel>
                        <TextBlock Text="Current transfers and verified file history." Foreground="{DynamicResource TextSecondaryBrush}" Margin="0,0,0,20" />
                        <Border Style="{StaticResource CardStyle}">
                            <StackPanel>
                                <TextBlock Text="Current transfer" FontWeight="SemiBold" />
                                <TextBlock Text="No transfer in progress." Foreground="{DynamicResource TextSecondaryBrush}" Margin="0,8,0,0">
                                    <TextBlock.Style><Style TargetType="TextBlock"><Style.Triggers><DataTrigger Binding="{Binding Transfer.HasTransfer}" Value="True"><Setter Property="Visibility" Value="Collapsed" /></DataTrigger></Style.Triggers></Style></TextBlock.Style>
                                </TextBlock>
                                <Grid x:Name="ActivityTransferGrid" Margin="0,12,0,0" Visibility="{Binding Transfer.IsActive, Converter={StaticResource BoolToVis}}">
                                    <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                                    <Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="Auto" /></Grid.RowDefinitions>
                                    <StackPanel Grid.Column="0">
                                        <TextBlock Text="{Binding Transfer.Title}" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" ToolTip="{Binding Transfer.Title}" />
                                        <TextBlock Text="{Binding Transfer.PhaseText}" Foreground="{DynamicResource TextSecondaryBrush}" Margin="0,3,0,0" />
                                        <TextBlock Text="{Binding Transfer.CurrentFile}" Foreground="{DynamicResource TextSecondaryBrush}" TextTrimming="CharacterEllipsis" Margin="0,3,0,0" />
                                    </StackPanel>
                                    <StackPanel x:Name="ActivityTransferActions" Grid.Column="1" HorizontalAlignment="Right" Orientation="Horizontal">
                                        <TextBlock Text="{Binding Transfer.BytesText}" Foreground="{DynamicResource TextSecondaryBrush}" VerticalAlignment="Center" Margin="0,0,14,0" />
                                        <TextBlock Text="{Binding Transfer.RateText}" FontWeight="SemiBold" VerticalAlignment="Center" Margin="0,0,14,0" />
                                        <Button Style="{StaticResource SecondaryButtonStyle}" Content="Cancel" Command="{Binding CancelTransferCommand}" />
                                    </StackPanel>
                                </Grid>
                                <ProgressBar x:Name="ActivityTransferProgressBar" Style="{StaticResource ModernProgressBarStyle}" Maximum="100" Value="{Binding Transfer.Progress, Mode=OneWay}" IsIndeterminate="{Binding Transfer.IsIndeterminate, Mode=OneWay}" Margin="0,14,0,0" Visibility="{Binding Transfer.IsActive, Converter={StaticResource BoolToVis}}" />
                                <StackPanel Margin="0,12,0,0" Visibility="{Binding Transfer.HasResult, Converter={StaticResource BoolToVis}}">
                                    <TextBlock Text="{Binding Transfer.Title}" FontWeight="SemiBold" FontSize="18" />
                                    <TextBlock Text="{Binding Transfer.PeerName}" Foreground="{DynamicResource TextSecondaryBrush}" Margin="0,4,0,0" />
                                    <TextBlock Text="{Binding Transfer.ResultSummary}" TextWrapping="Wrap" Margin="0,8,0,0" />
                                    <TextBlock Text="{Binding Transfer.VerifiedSummary}" Foreground="{DynamicResource TextSecondaryBrush}" Margin="0,4,0,0" Visibility="{Binding Transfer.HasVerifiedSummary, Converter={StaticResource BoolToVis}}" />
                                    <Expander Header="Technical details" Margin="0,10,0,0" Visibility="{Binding Transfer.HasDetails, Converter={StaticResource BoolToVis}}"><TextBlock Text="{Binding Transfer.Details}" TextWrapping="Wrap" Margin="0,8,0,0" /></Expander>
                                    <StackPanel Orientation="Horizontal" Margin="0,12,0,0">
                                        <Button Style="{StaticResource PrimaryButtonStyle}" Content="Open folder" Command="{Binding OpenTransferFolderCommand}" Visibility="{Binding Transfer.CanOpenFolder, Converter={StaticResource BoolToVis}}" Margin="0,0,8,0" />
                                        <Button Style="{StaticResource SecondaryButtonStyle}" Content="Try again" Command="{Binding RetryTransferCommand}" Visibility="{Binding Transfer.CanRetry, Converter={StaticResource BoolToVis}}" />
                                    </StackPanel>
                                </StackPanel>
                            </StackPanel>
                        </Border>
                        <Border Style="{StaticResource CardStyle}" Margin="0,12,0,0" Visibility="{Binding Transfer.HasPreviousResults, Converter={StaticResource BoolToVis}}">
                            <StackPanel>
                                <TextBlock Text="Earlier this session" FontWeight="SemiBold" />
                                <ItemsControl ItemsSource="{Binding Transfer.PreviousResults}" Margin="0,8,0,0">
                                    <ItemsControl.ItemTemplate><DataTemplate><Grid Margin="0,5"><Grid.ColumnDefinitions><ColumnDefinition Width="Auto" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions><TextBlock Text="{Binding Title}" FontWeight="SemiBold" /><TextBlock Grid.Column="1" Text="{Binding PeerName}" Foreground="{DynamicResource TextSecondaryBrush}" TextTrimming="CharacterEllipsis" Margin="12,0,0,0" /></Grid></DataTemplate></ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </StackPanel>
                        </Border>
                        <Border Style="{StaticResource CardStyle}" Margin="0,16,0,0">
                            <Grid>
                                <Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="*" /></Grid.RowDefinitions>
                                <Grid x:Name="ActivityHistoryHeader">
                                    <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                                    <Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="Auto" /></Grid.RowDefinitions>
                                    <StackPanel Grid.Column="0" Margin="0,0,12,0"><TextBlock Text="Verified history" FontWeight="SemiBold" /><TextBlock Text="Only completed, verified items are kept here." FontSize="12" Foreground="{DynamicResource TextSecondaryBrush}" Margin="0,3,0,0" TextWrapping="Wrap" /></StackPanel>
                                    <StackPanel x:Name="ActivityHistoryActions" Grid.Column="1" Orientation="Horizontal" HorizontalAlignment="Right">
                                        <StackPanel><TextBlock Text="Search history" Foreground="{DynamicResource TextSecondaryBrush}" FontSize="11" Margin="0,0,0,4" /><TextBox x:Name="ActivityHistorySearchBox" Style="{StaticResource ModernTextBoxStyle}" Width="145" Height="40" Text="{Binding ActivitySearchText, UpdateSourceTrigger=PropertyChanged}" ToolTip="Search history" AutomationProperties.Name="Search transfer activity" /></StackPanel>
                                        <StackPanel Margin="8,0,0,0"><TextBlock Text="Show" Foreground="{DynamicResource TextSecondaryBrush}" FontSize="11" Margin="0,0,0,4" /><ComboBox x:Name="ActivityHistoryFilterCombo" Width="145" Height="40" ItemsSource="{Binding ActivityFilterOptions}" SelectedItem="{Binding ActivityFilter}" AutomationProperties.Name="Filter transfer direction" /></StackPanel>
                                    </StackPanel>
                                </Grid>
                                <ListBox x:Name="ActivityHistoryList" Grid.Row="1" ItemsSource="{Binding ActivityItems}" BorderThickness="0" Background="Transparent" Margin="0,16,0,0" MaxHeight="320" HorizontalContentAlignment="Stretch" ScrollViewer.HorizontalScrollBarVisibility="Disabled" ScrollViewer.CanContentScroll="True" VirtualizingPanel.IsVirtualizing="True">
                                    <ListBox.ItemTemplate>
                                        <DataTemplate>
                                            <Grid Margin="0,7">
                                                <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="116" /><ColumnDefinition Width="116" /></Grid.ColumnDefinitions>
                                                <StackPanel><TextBlock Text="{Binding ItemName}" Foreground="{DynamicResource TextPrimaryBrush}" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" /><TextBlock Text="{Binding Direction}" Foreground="{DynamicResource TextSecondaryBrush}" FontSize="11" /></StackPanel>
                                                <StackPanel Grid.Column="1" Margin="6,0"><TextBlock Text="{Binding FormattedSize}" Foreground="{DynamicResource TextPrimaryBrush}" HorizontalAlignment="Right" /><TextBlock Text="{Binding FormattedTime}" Foreground="{DynamicResource TextSecondaryBrush}" HorizontalAlignment="Right" FontSize="11" /></StackPanel>
                                                <Button Grid.Column="2" Style="{StaticResource SecondaryButtonStyle}" Content="Open folder" Command="{Binding DataContext.OpenHistoryItemCommand, RelativeSource={RelativeSource AncestorType=Window}}" CommandParameter="{Binding}" Width="110" HorizontalAlignment="Right" VerticalAlignment="Center" />
                                            </Grid>
                                        </DataTemplate>
                                    </ListBox.ItemTemplate>
                                </ListBox>
                            </Grid>
                        </Border>
                    </StackPanel>
                </ScrollViewer>

                <!-- Settings -->
                <ScrollViewer x:Name="SettingsPage" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" Visibility="{Binding IsSettingsSelected, Converter={StaticResource BoolToVis}}">
                    <StackPanel>
                        <TextBlock Text="Control how Glide appears and receives files." Foreground="{DynamicResource TextSecondaryBrush}" Margin="0,0,0,20" />
                        <Border Style="{StaticResource CardStyle}">
                            <StackPanel><TextBlock Text="Appearance" FontWeight="SemiBold" /><TextBlock Text="Match Windows by default, or choose a theme for Glide." Foreground="{DynamicResource TextSecondaryBrush}" FontSize="12" Margin="0,4,0,12" /><ComboBox ItemsSource="{Binding AppearanceOptions}" SelectedItem="{Binding AppearanceMode}" Width="180" HorizontalAlignment="Left" AutomationProperties.Name="Appearance theme" /></StackPanel>
                        </Border>
                        <Border Style="{StaticResource CardStyle}" Margin="0,16,0,0">
                            <StackPanel><TextBlock Text="Receiving" FontWeight="SemiBold" /><TextBlock Text="Save received files to" Foreground="{DynamicResource TextSecondaryBrush}" FontSize="12" Margin="0,12,0,6" />
                                <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions><TextBox Style="{StaticResource ModernTextBoxStyle}" Text="{Binding ReceiveDirectory}" IsReadOnly="True" AutomationProperties.Name="Receive folder" /><Button Grid.Column="1" Style="{StaticResource SecondaryButtonStyle}" Content="Change folder" Command="{Binding BrowseReceiveFolderCommand}" Margin="8,0,0,0" /></Grid>
                                <Expander Header="Advanced connection details" Margin="0,16,0,0"><StackPanel Margin="0,10,0,0"><TextBlock Text="{Binding LocalIpText, StringFormat=Local address: {0}}" Foreground="{DynamicResource TextSecondaryBrush}" /><TextBlock Text="{Binding ListeningPort, StringFormat=Listening port: {0}}" Foreground="{DynamicResource TextSecondaryBrush}" Margin="0,5,0,0" /><TextBlock Text="{Binding LocalIdentityFingerprint, StringFormat=Device fingerprint: {0}}" TextWrapping="Wrap" Foreground="{DynamicResource TextSecondaryBrush}" Margin="0,5,0,0" /></StackPanel></Expander>
                            </StackPanel>
                        </Border>
                        <Border Style="{StaticResource CardStyle}" Margin="0,16,0,0">
                            <StackPanel><TextBlock Text="Trusted devices" FontWeight="SemiBold" /><TextBlock Text="{Binding TrustedDevicesSummary}" Foreground="{DynamicResource TextSecondaryBrush}" FontSize="12" Margin="0,4,0,12" />
                                <ItemsControl ItemsSource="{Binding TrustedDevices}"><ItemsControl.ItemTemplate><DataTemplate><StackPanel Margin="0,5"><Grid><Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions><TextBlock Text="{Binding DisplayName}" ToolTip="{Binding DisplayName}" TextTrimming="CharacterEllipsis" FontWeight="SemiBold" VerticalAlignment="Center" /><Button Grid.Column="1" Style="{StaticResource SecondaryButtonStyle}" Content="Remove" Command="{Binding DataContext.RevokeTrustedDeviceCommand, RelativeSource={RelativeSource AncestorType=Window}}" CommandParameter="{Binding}" VerticalAlignment="Center" /></Grid><Expander Header="Details" Margin="0,4,0,0"><StackPanel Margin="0,4,0,0"><TextBlock Text="{Binding FingerprintHex}" Foreground="{DynamicResource TextSecondaryBrush}" FontFamily="Consolas" FontSize="11" TextWrapping="Wrap" /><TextBlock Text="{Binding LastSeenText}" Foreground="{DynamicResource TextSecondaryBrush}" FontSize="11" Margin="0,2,0,0" /></StackPanel></Expander></StackPanel></DataTemplate></ItemsControl.ItemTemplate></ItemsControl>
                            </StackPanel>
                        </Border>
                    </StackPanel>
                </ScrollViewer>
            </Grid>

            <Border Grid.Row="2" Margin="0,16,0,0" Background="{DynamicResource SurfaceRaisedBrush}" CornerRadius="8" Padding="12" Visibility="{Binding IsTransferBannerVisible, Converter={StaticResource BoolToVis}}">
                <Grid><TextBlock Text="{Binding Transfer.Title}" FontWeight="SemiBold" /><TextBlock HorizontalAlignment="Right" Text="{Binding Transfer.BytesText}" Foreground="{DynamicResource TextSecondaryBrush}" /></Grid>
            </Border>
        </Grid>

        <!-- Saved device picker -->
        <Border Grid.ColumnSpan="2" Background="#99000000" Visibility="{Binding IsTrustedDevicePickerVisible, Converter={StaticResource BoolToVis}}" Panel.ZIndex="11" IsVisibleChanged="TrustedPicker_IsVisibleChanged">
            <Border Style="{StaticResource CardStyle}" MaxWidth="480" Margin="12" HorizontalAlignment="Stretch" VerticalAlignment="Center" Padding="28" KeyboardNavigation.TabNavigation="Cycle">
                <StackPanel>
                    <TextBlock Text="Choose a saved device" FontSize="20" FontWeight="SemiBold" />
                    <TextBlock Text="{Binding TrustedDevicesSummary}" Foreground="{DynamicResource TextSecondaryBrush}" TextWrapping="Wrap" Margin="0,6,0,16" />
                    <ScrollViewer x:Name="TrustedDevicesScroll" MaxHeight="260" VerticalScrollBarVisibility="Auto">
                        <ItemsControl ItemsSource="{Binding TrustedDevices}">
                            <ItemsControl.ItemTemplate><DataTemplate>
                                <Button Style="{StaticResource SecondaryButtonStyle}" Command="{Binding DataContext.SelectTrustedDeviceCommand, RelativeSource={RelativeSource AncestorType=Window}}" CommandParameter="{Binding}" HorizontalAlignment="Stretch" HorizontalContentAlignment="Stretch" Margin="0,0,0,8" AutomationProperties.Name="{Binding ConnectAutomationName}">
                                    <Grid HorizontalAlignment="Stretch"><Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="16" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions><StackPanel Grid.Column="0"><TextBlock Text="{Binding DisplayName}" Foreground="{DynamicResource TextPrimaryBrush}" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" ToolTip="{Binding DisplayName}" /><TextBlock Text="{Binding LastSeenText}" Foreground="{DynamicResource TextSecondaryBrush}" FontSize="11" TextTrimming="CharacterEllipsis" ToolTip="{Binding LastSeenText}" /></StackPanel><TextBlock Grid.Column="2" Text="Connect" Foreground="{DynamicResource PrimaryBrush}" VerticalAlignment="Center" /></Grid>
                                </Button>
                            </DataTemplate></ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </ScrollViewer>
                    <TextBlock Text="Glide verifies the selected device before each transfer." Foreground="{DynamicResource TextSecondaryBrush}" FontSize="12" TextWrapping="Wrap" Margin="0,8,0,16" />
                    <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions><Button Grid.Column="0" Style="{StaticResource SecondaryButtonStyle}" Content="Pair a new device" Command="{Binding ShowPairModalCommand}" HorizontalAlignment="Left" /><Button x:Name="CloseTrustedDevicePickerButton" Grid.Column="1" Style="{StaticResource SecondaryButtonStyle}" Content="Close" Command="{Binding CloseTrustedDevicePickerCommand}" /></Grid>
                </StackPanel>
            </Border>
        </Border>

        <!-- Connect a saved identity with a fresh one-use invitation. -->
        <Border Grid.ColumnSpan="2" Background="#99000000" Visibility="{Binding IsSavedDeviceConnectVisible, Converter={StaticResource BoolToVis}}" Panel.ZIndex="12" IsVisibleChanged="SavedDeviceConnect_IsVisibleChanged">
            <Border Style="{StaticResource CardStyle}" MaxWidth="500" Margin="12" HorizontalAlignment="Stretch" VerticalAlignment="Center" Padding="28" KeyboardNavigation.TabNavigation="Cycle">
                <StackPanel>
                    <TextBlock Text="{Binding SelectedTrustedDeviceName, StringFormat='Connect to {0}'}" FontSize="20" FontWeight="SemiBold" />
                    <TextBlock Text="On the receiving device, open Glide Receive and copy its current pairing link. Glide will verify that it is the saved device before sending." Foreground="{DynamicResource TextSecondaryBrush}" TextWrapping="Wrap" Margin="0,8,0,16" />
                    <TextBox x:Name="SavedDeviceInvitationInput" Style="{StaticResource ModernTextBoxStyle}" Text="{Binding PairInputUri, UpdateSourceTrigger=PropertyChanged}" TextWrapping="Wrap" MinHeight="56" AutomationProperties.Name="Current pairing link from saved device" />
                    <TextBlock Text="{Binding PairingStatusText}" Foreground="{DynamicResource TextSecondaryBrush}" TextWrapping="Wrap" Margin="0,8,0,0" AutomationProperties.LiveSetting="Polite" />
                    <StackPanel Orientation="Horizontal" Margin="0,16,0,0">
                        <Button Style="{StaticResource SecondaryButtonStyle}" Content="Paste link" Command="{Binding PastePairingLinkCommand}" Margin="0,0,8,0" />
                        <Button Style="{StaticResource PrimaryButtonStyle}" Content="Connect and send" Command="{Binding ConnectSavedDeviceCommand}" />
                    </StackPanel>
                    <TextBlock Text="Or show a QR code for a phone running Glide to scan." Foreground="{DynamicResource TextSecondaryBrush}" TextWrapping="Wrap" Margin="0,18,0,8" />
                    <Grid>
                        <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                        <Button Style="{StaticResource SecondaryButtonStyle}" Content="Show QR code" Command="{Binding ShowSavedDeviceQrCommand}" HorizontalAlignment="Left" />
                        <Button x:Name="CloseSavedDeviceConnectButton" Grid.Column="1" Style="{StaticResource SecondaryButtonStyle}" Content="Cancel" Command="{Binding CloseSavedDeviceConnectCommand}" />
                    </Grid>
                </StackPanel>
            </Border>
        </Border>

        <!-- Receiving consent -->
        <Border Grid.ColumnSpan="2" Background="#99000000" Visibility="{Binding IsOfferModalVisible, Converter={StaticResource BoolToVis}}" Panel.ZIndex="10">
            <Border Style="{StaticResource CardStyle}" MaxWidth="470" Margin="12" HorizontalAlignment="Stretch" VerticalAlignment="Center" Padding="28" KeyboardNavigation.TabNavigation="Cycle">
                <StackPanel><TextBlock Text="Incoming transfer" FontSize="20" FontWeight="SemiBold" HorizontalAlignment="Center" /><TextBlock Text="{Binding IncomingOfferPeer}" FontWeight="SemiBold" HorizontalAlignment="Center" Margin="0,10,0,4" /><TextBlock Text="{Binding IncomingOfferSummary}" TextAlignment="Center" Foreground="{DynamicResource TextSecondaryBrush}" TextWrapping="Wrap" /><TextBlock Text="Review the sender and file summary. Accepted files are written to your selected receive folder." TextAlignment="Center" Foreground="{DynamicResource TextSecondaryBrush}" FontSize="12" TextWrapping="Wrap" Margin="0,12,0,20" /><Grid><Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="12" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions><Button Grid.Column="0" Style="{StaticResource SecondaryButtonStyle}" Content="Decline" Command="{Binding RejectOfferCommand}" /><Button Grid.Column="2" Style="{StaticResource PrimaryButtonStyle}" Content="Accept transfer" Command="{Binding AcceptOfferCommand}" /></Grid></StackPanel>
            </Border>
        </Border>

        <!-- Trust consent -->
        <Border Grid.ColumnSpan="2" Background="#99000000" Visibility="{Binding IsTrustEnrollmentModalVisible, Converter={StaticResource BoolToVis}}" Panel.ZIndex="102">
            <Border Style="{StaticResource CardStyle}" MaxWidth="510" Margin="12" HorizontalAlignment="Stretch" VerticalAlignment="Center" Padding="28" KeyboardNavigation.TabNavigation="Cycle">
                <StackPanel><TextBlock Text="Trust this device?" FontSize="20" FontWeight="SemiBold" HorizontalAlignment="Center" /><TextBlock Text="{Binding TrustEnrollmentPeerName}" FontWeight="SemiBold" HorizontalAlignment="Center" Margin="0,10,0,8" /><TextBlock Text="Glide verified this device for the current session. Compare the full fingerprint before letting Glide recognise it in future sessions." TextAlignment="Center" Foreground="{DynamicResource TextSecondaryBrush}" TextWrapping="Wrap" /><Border Background="{DynamicResource SurfaceRaisedBrush}" CornerRadius="8" Padding="12" Margin="0,16"><TextBlock Text="{Binding TrustEnrollmentFingerprint}" FontFamily="Consolas" TextAlignment="Center" TextWrapping="Wrap" /></Border><Grid><Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="12" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions><Button Grid.Column="0" Style="{StaticResource SecondaryButtonStyle}" Content="Not Now" Command="{Binding RejectTrustEnrollmentCommand}" /><Button Grid.Column="2" Style="{StaticResource PrimaryButtonStyle}" Content="Trust Device" Command="{Binding AcceptTrustEnrollmentCommand}" /></Grid></StackPanel>
            </Border>
        </Border>

        <!-- Recipient confirmation -->
        <Border Grid.ColumnSpan="2" Background="#99000000" Visibility="{Binding IsRecipientConfirmationModalVisible, Converter={StaticResource BoolToVis}}" Panel.ZIndex="103">
            <Border Style="{StaticResource CardStyle}" MaxWidth="460" Margin="12" HorizontalAlignment="Stretch" VerticalAlignment="Center" Padding="28" KeyboardNavigation.TabNavigation="Cycle">
                <StackPanel><TextBlock Text="Confirm receiving device" FontSize="20" FontWeight="SemiBold" HorizontalAlignment="Center" /><TextBlock Text="{Binding RecipientConfirmationPeerName}" FontWeight="SemiBold" HorizontalAlignment="Center" Margin="0,10,0,8" /><TextBlock Text="This device scanned your one-time code. Confirm it before Glide reveals the selected files or starts transfer." TextAlignment="Center" Foreground="{DynamicResource TextSecondaryBrush}" TextWrapping="Wrap" Margin="0,0,0,20" /><Grid><Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="12" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions><Button Grid.Column="0" Style="{StaticResource SecondaryButtonStyle}" Content="Reject" Command="{Binding RejectRecipientCommand}" /><Button Grid.Column="2" Style="{StaticResource PrimaryButtonStyle}" Content="Send files" Command="{Binding AcceptRecipientCommand}" /></Grid></StackPanel>
            </Border>
        </Border>

        <!-- Pairing -->
        <Border Grid.ColumnSpan="2" Background="#99000000" Visibility="{Binding IsPairModalVisible, Converter={StaticResource BoolToVis}}" Panel.ZIndex="13">
            <Border Style="{StaticResource CardStyle}" MaxWidth="500" Margin="12" HorizontalAlignment="Stretch" VerticalAlignment="Center" Padding="28" KeyboardNavigation.TabNavigation="Cycle">
                <StackPanel><TextBlock Text="{Binding PairingSheetTitle}" FontSize="20" FontWeight="SemiBold" HorizontalAlignment="Center" /><TextBlock Text="{Binding PairingSheetInstruction}" Foreground="{DynamicResource TextSecondaryBrush}" TextAlignment="Center" TextWrapping="Wrap" Margin="0,10,0,18" />
                    <StackPanel Visibility="{Binding IsHostedSendQrVisible, Converter={StaticResource BoolToVis}}" HorizontalAlignment="Center"><Border Background="White" CornerRadius="10" Padding="12"><Image x:Name="HostedQrImage" Source="{Binding PairingQrImage}" Width="260" Height="260" Stretch="Uniform" RenderOptions.BitmapScalingMode="NearestNeighbor" AutomationProperties.Name="QR code for receiving selected files" /></Border><TextBlock Text="This code expires automatically for your security." Foreground="{DynamicResource TextSecondaryBrush}" FontSize="12" HorizontalAlignment="Center" Margin="0,10,0,0" /></StackPanel>
                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" Margin="0,16,0,0"><Button Style="{StaticResource SecondaryButtonStyle}" Content="Refresh code" Command="{Binding RefreshQrCommand}" Width="160" Margin="0,0,8,0" /><Button x:Name="CancelQuickShareButton" Style="{StaticResource SecondaryButtonStyle}" Content="Cancel QR share" Command="{Binding CancelPairModalCommand}" Width="160" /></StackPanel>
                </StackPanel>
            </Border>
        </Border>

        <Border Grid.ColumnSpan="2" Background="#CC000000" Visibility="{Binding IsQrZoomModalVisible, Converter={StaticResource BoolToVis}}" Panel.ZIndex="14">
            <Border Style="{StaticResource CardStyle}" MaxWidth="500" Margin="12" HorizontalAlignment="Stretch" VerticalAlignment="Center" Padding="28" KeyboardNavigation.TabNavigation="Cycle">
                <StackPanel><TextBlock Text="Scan with Glide Mobile" FontSize="20" FontWeight="SemiBold" HorizontalAlignment="Center" Margin="0,0,0,16" /><Border Background="White" CornerRadius="12" Padding="16" HorizontalAlignment="Center"><Image x:Name="ZoomQrImage" Source="{Binding PairingQrImage}" Width="320" Height="320" Stretch="Uniform" RenderOptions.BitmapScalingMode="NearestNeighbor" /></Border><StackPanel Orientation="Horizontal" HorizontalAlignment="Center" Margin="0,18,0,0"><Button Style="{StaticResource SecondaryButtonStyle}" Content="Refresh" Command="{Binding RefreshQrCommand}" Margin="0,0,8,0" /><Button Style="{StaticResource SecondaryButtonStyle}" Content="Copy link" Command="{Binding CopyPairingLinkCommand}" Margin="0,0,8,0" /><Button Style="{StaticResource PrimaryButtonStyle}" Content="Close" Command="{Binding ToggleQrZoomCommand}" /></StackPanel></StackPanel>
            </Border>
        </Border>
    </Grid>
</Window>
