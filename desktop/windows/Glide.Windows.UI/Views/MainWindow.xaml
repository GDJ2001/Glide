<Window x:Class="Glide.Windows.UI.Views.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:vm="clr-namespace:Glide.Windows.UI.ViewModels"
        mc:Ignorable="d"
        Title="Glide — Local sharing" Height="720" Width="1040" MinWidth="820" MinHeight="560"
        WindowStartupLocation="CenterScreen" Icon="pack://application:,,,/Glide;component/glide.ico"
        Background="{DynamicResource AppBackgroundBrush}" Foreground="{DynamicResource TextPrimaryBrush}">
    <Window.DataContext>
        <vm:MainViewModel />
    </Window.DataContext>

    <Grid KeyboardNavigation.TabNavigation="Cycle">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="212" />
            <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>

        <Border Grid.Column="0" Background="{DynamicResource SidebarBrush}" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="0,0,1,0" Padding="16,20">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>

                <StackPanel>
                    <StackPanel Orientation="Horizontal" Margin="8,0,0,28">
                        <Image Source="/Glide;component/Assets/glide-symbol-blue-96.png" Width="30" Height="30" Stretch="Uniform" Margin="0,0,10,0" />
                        <StackPanel>
                            <TextBlock Text="Glide" FontSize="18" FontWeight="Bold" Foreground="{DynamicResource TextPrimaryBrush}" />
                            <TextBlock Text="Local sharing" FontSize="11" Foreground="{DynamicResource TextSecondaryBrush}" />
                        </StackPanel>
                    </StackPanel>

                    <RadioButton Style="{StaticResource NavButtonStyle}" GroupName="Navigation" IsChecked="{Binding IsSendSelected, Mode=OneWay}" Command="{Binding SwitchTabCommand}" CommandParameter="Send" AutomationProperties.Name="Send files">
                        <StackPanel Orientation="Horizontal"><Path Data="{StaticResource IconSend}" Fill="{Binding Foreground, RelativeSource={RelativeSource AncestorType=RadioButton}}" Stretch="Uniform" Width="20" Height="20" Margin="0,0,12,0" /><TextBlock Text="Send" VerticalAlignment="Center" /></StackPanel>
                    </RadioButton>
                    <RadioButton Style="{StaticResource NavButtonStyle}" GroupName="Navigation" IsChecked="{Binding IsReceiveSelected, Mode=OneWay}" Command="{Binding SwitchTabCommand}" CommandParameter="Receive" AutomationProperties.Name="Receive files">
                        <StackPanel Orientation="Horizontal"><Path Data="{StaticResource IconReceive}" Fill="{Binding Foreground, RelativeSource={RelativeSource AncestorType=RadioButton}}" Stretch="Uniform" Width="20" Height="20" Margin="0,0,12,0" /><TextBlock Text="Receive" VerticalAlignment="Center" /></StackPanel>
                    </RadioButton>
                    <RadioButton Style="{StaticResource NavButtonStyle}" GroupName="Navigation" IsChecked="{Binding IsActivitySelected, Mode=OneWay}" Command="{Binding SwitchTabCommand}" CommandParameter="Activity" AutomationProperties.Name="Transfer activity">
                        <StackPanel Orientation="Horizontal"><Path Data="{StaticResource IconActivity}" Fill="{Binding Foreground, RelativeSource={RelativeSource AncestorType=RadioButton}}" Stretch="Uniform" Width="20" Height="20" Margin="0,0,12,0" /><TextBlock Text="Activity" VerticalAlignment="Center" /></StackPanel>
                    </RadioButton>
                    <RadioButton Style="{StaticResource NavButtonStyle}" GroupName="Navigation" IsChecked="{Binding IsPairDevicesSelected, Mode=OneWay}" Command="{Binding SwitchTabCommand}" CommandParameter="Pair devices" AutomationProperties.Name="Pair devices">
                        <StackPanel Orientation="Horizontal"><Path Data="{StaticResource IconPhone}" Fill="{Binding Foreground, RelativeSource={RelativeSource AncestorType=RadioButton}}" Stretch="Uniform" Width="20" Height="20" Margin="0,0,12,0" /><TextBlock Text="Pair devices" VerticalAlignment="Center" /></StackPanel>
                    </RadioButton>
                </StackPanel>

                <StackPanel Grid.Row="2">
                    <Border Background="{DynamicResource SurfaceRaisedBrush}" CornerRadius="8" Padding="12" Margin="0,0,0,12">
                        <StackPanel>
                            <TextBlock Text="Sharing is local" FontWeight="SemiBold" FontSize="12" />
                            <TextBlock Text="Files stay on your network. You approve every new connection." TextWrapping="Wrap" FontSize="11" Foreground="{DynamicResource TextSecondaryBrush}" Margin="0,4,0,0" />
                        </StackPanel>
                    </Border>
                    <RadioButton Style="{StaticResource NavButtonStyle}" GroupName="Navigation" IsChecked="{Binding IsSettingsSelected, Mode=OneWay}" Command="{Binding SwitchTabCommand}" CommandParameter="Settings" AutomationProperties.Name="Settings">
                        <StackPanel Orientation="Horizontal"><Path Data="{StaticResource IconSettings}" Fill="{Binding Foreground, RelativeSource={RelativeSource AncestorType=RadioButton}}" Stretch="Uniform" Width="20" Height="20" Margin="0,0,12,0" /><TextBlock Text="Settings" VerticalAlignment="Center" /></StackPanel>
                    </RadioButton>
                </StackPanel>
            </Grid>
        </Border>

        <Grid Grid.Column="1" Margin="32,28,32,24">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <Grid>
                <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                <StackPanel Grid.Column="0" Margin="0,0,12,0">
                    <TextBlock Text="{Binding CurrentTab}" FontSize="26" FontWeight="SemiBold" />
                    <TextBlock Text="{Binding StatusMessage}" Foreground="{DynamicResource TextSecondaryBrush}" Margin="0,4,0,0" TextTrimming="CharacterEllipsis" />
                </StackPanel>
                <Button Grid.Column="1" Style="{StaticResource SecondaryButtonStyle}" Command="{Binding OpenDownloadsCommand}" HorizontalAlignment="Right" AutomationProperties.Name="Open received files folder">
                    <StackPanel Orientation="Horizontal"><Path Data="{StaticResource IconFolderOpen}" Fill="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}" Stretch="Uniform" Width="18" Height="18" Margin="0,0,8,0" /><TextBlock Text="Received files" /></StackPanel>
                </Button>
            </Grid>

            <Grid Grid.Row="1" Margin="0,28,0,0">
                <!-- Send -->
                <ScrollViewer x:Name="SendPage" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" Visibility="{Binding IsSendSelected, Converter={StaticResource BoolToVis}}">
                    <StackPanel>
                        <TextBlock Text="Choose files, then pick a nearby device or connect your phone with a one-time QR code." Foreground="{DynamicResource TextSecondaryBrush}" Margin="0,0,0,20" TextWrapping="Wrap" />

                        <Border x:Name="SendDropZone" Style="{StaticResource CardStyle}" BorderBrush="{DynamicResource PrimaryBrush}" BorderThickness="1" AllowDrop="True" Drop="DropZone_Drop" DragOver="DropZone_DragOver">
                            <StackPanel HorizontalAlignment="Center" Margin="0,8">
                                <Path Data="{StaticResource IconDocumentAdd}" Fill="{DynamicResource PrimaryBrush}" Stretch="Uniform" Width="32" Height="32" HorizontalAlignment="Center" />
                                <TextBlock Text="Drop files or folders here" FontSize="16" FontWeight="SemiBold" HorizontalAlignment="Center" Margin="0,10,0,4" />
                                <TextBlock Text="Or choose what to share from your computer" Foreground="{DynamicResource TextSecondaryBrush}" HorizontalAlignment="Center" />
                                <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" Margin="0,16,0,0">
                                    <Button Style="{StaticResource PrimaryButtonStyle}" Command="{Binding AddFilesCommand}" Margin="0,0,8,0" MinWidth="116" AutomationProperties.Name="Add files to send"><StackPanel Orientation="Horizontal"><Path Data="{StaticResource IconDocumentAdd}" Fill="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}" Width="18" Height="18" Stretch="Uniform" Margin="0,0,8,0" /><TextBlock Text="Add files" VerticalAlignment="Center" /></StackPanel></Button>
                                    <Button Style="{StaticResource SecondaryButtonStyle}" Command="{Binding AddFolderCommand}" MinWidth="116" AutomationProperties.Name="Add folder to send"><StackPanel Orientation="Horizontal"><Path Data="{StaticResource IconFolderAdd}" Fill="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}" Width="18" Height="18" Stretch="Uniform" Margin="0,0,8,0" /><TextBlock Text="Add folder" VerticalAlignment="Center" /></StackPanel></Button>
                                </StackPanel>
                            </StackPanel>
                        </Border>

                        <Border Style="{StaticResource CardStyle}" Margin="0,16,0,0">
                            <Grid>
                                <Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="*" /></Grid.RowDefinitions>
                                <Grid>
                                    <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                                    <StackPanel Margin="0,0,12,0">
                                        <TextBlock Text="Ready to send" FontWeight="SemiBold" />
                                        <TextBlock Text="{Binding SelectedFilesSummary}" Foreground="{DynamicResource TextSecondaryBrush}" FontSize="12" Margin="0,3,0,0" TextWrapping="Wrap" />
                                    </StackPanel>
                                    <Button Grid.Column="1" Style="{StaticResource SecondaryButtonStyle}" Content="Clear list" Command="{Binding ClearFilesCommand}" HorizontalAlignment="Right" />
                                </Grid>
                                <ListBox Grid.Row="1" ItemsSource="{Binding SelectedFiles}" BorderThickness="0" Background="Transparent" Margin="0,16,0,0" MaxHeight="220" HorizontalContentAlignment="Stretch" ScrollViewer.HorizontalScrollBarVisibility="Disabled" ScrollViewer.CanContentScroll="True" VirtualizingPanel.IsVirtualizing="True">
                                    <ListBox.ItemTemplate>
                                        <DataTemplate>
                                            <Grid Margin="0,4">
                                                <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="100" /><ColumnDefinition Width="80" /></Grid.ColumnDefinitions>
                                                <StackPanel>
                                                    <TextBlock Text="{Binding Name}" Foreground="{DynamicResource TextPrimaryBrush}" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" ToolTip="{Binding Name}" />
                                                    <TextBlock Text="{Binding Status}" Foreground="{DynamicResource TextSecondaryBrush}" FontSize="11" />
                                                </StackPanel>
                                                <TextBlock Grid.Column="1" Text="{Binding FormattedSize}" Foreground="{DynamicResource TextSecondaryBrush}" VerticalAlignment="Center" HorizontalAlignment="Right" Margin="8,0" />
                                                <Button Grid.Column="2" Style="{StaticResource SecondaryButtonStyle}" Content="Remove" Command="{Binding DataContext.RemoveFileCommand, RelativeSource={RelativeSource AncestorType=ListBox}}" CommandParameter="{Binding}" VerticalAlignment="Center" Width="76" Padding="10,4" MinHeight="32" AutomationProperties.Name="Remove queued file" />
                                            </Grid>
                                        </DataTemplate>
                                    </ListBox.ItemTemplate>
                                </ListBox>
                            </Grid>
                        </Border>

                        <Border Style="{StaticResource CardStyle}" Margin="0,16,0,0">
                            <StackPanel>
                                <TextBlock Text="Choose a device" FontWeight="SemiBold" FontSize="16" />
                                <TextBlock Text="Select one way to send these files." Foreground="{DynamicResource TextSecondaryBrush}" FontSize="12" Margin="0,4,0,14" />
                                <RadioButton Style="{StaticResource SendMethodCardStyle}" GroupName="SendMethod" IsChecked="{Binding IsQuickQrSelected, Mode=OneWay}" IsEnabled="{Binding HasSelectedFiles}" Command="{Binding SelectSendMethodCommand}" CommandParameter="QuickQr" AutomationProperties.Name="Quick share with QR code" Margin="0,0,0,8">
                                    <StackPanel Orientation="Horizontal"><Path Data="{StaticResource IconPhone}" Fill="{DynamicResource PrimaryBrush}" Width="22" Height="22" Stretch="Uniform" VerticalAlignment="Center" Margin="0,0,12,0" /><StackPanel><TextBlock Text="Quick share with QR" Foreground="{DynamicResource TextPrimaryBrush}" FontWeight="SemiBold" /><TextBlock Text="Show a code now. Sending starts after scan and your approval." Foreground="{DynamicResource TextSecondaryBrush}" FontSize="12" TextWrapping="Wrap" /></StackPanel></StackPanel>
                                </RadioButton>
                                <RadioButton Style="{StaticResource SendMethodCardStyle}" GroupName="SendMethod" IsChecked="{Binding IsNearbySelected, Mode=OneWay}" IsEnabled="{Binding HasSelectedFiles}" Command="{Binding SelectSendMethodCommand}" CommandParameter="Nearby" AutomationProperties.Name="Nearby device" Margin="0,0,0,8">
                                    <StackPanel Orientation="Horizontal"><Path Data="{StaticResource IconLaptop}" Fill="{DynamicResource PrimaryBrush}" Width="22" Height="22" Stretch="Uniform" VerticalAlignment="Center" Margin="0,0,12,0" /><StackPanel><TextBlock Text="Nearby device" Foreground="{DynamicResource TextPrimaryBrush}" FontWeight="SemiBold" /><TextBlock Text="Find a device and use its current pairing invitation." Foreground="{DynamicResource TextSecondaryBrush}" FontSize="12" TextWrapping="Wrap" /></StackPanel></StackPanel>
                                </RadioButton>
                                <RadioButton Style="{StaticResource SendMethodCardStyle}" GroupName="SendMethod" IsChecked="{Binding IsTrustedSelected, Mode=OneWay}" IsEnabled="{Binding HasSelectedFiles}" Command="{Binding SelectSendMethodCommand}" CommandParameter="Trusted" AutomationProperties.Name="Saved device">
                                    <StackPanel Orientation="Horizontal"><Path Data="{StaticResource IconActivity}" Fill="{DynamicResource PrimaryBrush}" Width="22" Height="22" Stretch="Uniform" VerticalAlignment="Center" Margin="0,0,12,0" /><StackPanel><TextBlock Text="Saved device" Foreground="{DynamicResource TextPrimaryBrush}" FontWeight="SemiBold" /><TextBlock Text="Choose a trusted device. Glide verifies it again for this send." Foreground="{DynamicResource TextSecondaryBrush}" FontSize="12" TextWrapping="Wrap" /></StackPanel></StackPanel>
                                </RadioButton>
                                <TextBlock Text="{Binding SelectedSendMethodText}" Foreground="{DynamicResource TextSecondaryBrush}" TextWrapping="Wrap" Margin="0,14,0,0" AutomationProperties.LiveSetting="Polite" />
                                <Button x:Name="SendChosenDeviceButton" Style="{StaticResource PrimaryButtonStyle}" Content="{Binding SendActionText}" Command="{Binding SendFilesCommand}" Visibility="{Binding IsSendActionVisible, Converter={StaticResource BoolToVis}}" HorizontalAlignment="Right" Margin="0,14,0,0" AutomationProperties.Name="Send selected files to chosen device" />
                            </StackPanel>
                        </Border>
                    </StackPanel>
                </ScrollViewer>

                <!-- Pair devices -->
                <ScrollViewer x:Name="PairDevicesPage" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" Visibility="{Binding IsPairDevicesSelected, Converter={StaticResource BoolToVis}}">
                    <StackPanel>
                        <TextBlock Text="Connect a receiving device, then return to Send. A device is saved only after a verified transfer and your approval." Foreground="{DynamicResource TextSecondaryBrush}" TextWrapping="Wrap" Margin="0,0,0,20" />
                        <Border Style="{StaticResource CardStyle}">
                            <StackPanel>
                                <TextBlock Text="Pair with a QR or link" FontWeight="SemiBold" FontSize="16" />
                                <TextBlock Text="On the receiving device, open Receive and copy its current Glide pairing link. Paste it here. The link is also encoded in that device's QR code." Foreground="{DynamicResource TextSecondaryBrush}" TextWrapping="Wrap" FontSize="12" Margin="0,4,0,12" />
                                <TextBox Style="{StaticResource ModernTextBoxStyle}" Text="{Binding PairInputUri, UpdateSourceTrigger=PropertyChanged}" TextWrapping="Wrap" MinHeight="56" AutomationProperties.Name="Receiving device pairing link" />
                                <StackPanel Orientation="Horizontal" Margin="0,12,0,0">
                                    <Button Style="{StaticResource SecondaryButtonStyle}" Content="Paste link" Command="{Binding PastePairingLinkCommand}" Margin="0,0,8,0" />
                                    <Button Style="{StaticResource PrimaryButtonStyle}" Content="Use invitation" Command="{Binding SubmitPairModalCommand}" />
                                </StackPanel>
                                <TextBlock Text="{Binding PairingStatusText}" Foreground="{DynamicResource TextSecondaryBrush}" TextWrapping="Wrap" Margin="0,12,0,0" AutomationProperties.LiveSetting="Polite" />
                            </StackPanel>
                        </Border>
                        <Border Style="{StaticResource CardStyle}" Margin="0,16,0,0">
                            <StackPanel>
                                <TextBlock Text="Find a nearby device" FontWeight="SemiBold" FontSize="16" />
                                <TextBlock Text="Discovery shows availability. Select a device, then use its invitation above to authenticate it." Foreground="{DynamicResource TextSecondaryBrush}" FontSize="12" TextWrapping="Wrap" Margin="0,4,0,12" />
                                <TextBlock Text="No nearby devices found. Open Glide on the other device, turn on Receive, then refresh." Foreground="{DynamicResource TextSecondaryBrush}" TextWrapping="Wrap" Margin="0,0,0,12">
                                    <TextBlock.Style><Style TargetType="TextBlock"><Style.Triggers><DataTrigger Binding="{Binding HasDiscoveredPeers}" Value="True"><Setter Property="Visibility" Value="Collapsed" /></DataTrigger></Style.Triggers></Style></TextBlock.Style>
                                </TextBlock>
                                <ItemsControl ItemsSource="{Binding DiscoveredPeers}">
                                    <ItemsControl.ItemsPanel><ItemsPanelTemplate><WrapPanel /></ItemsPanelTemplate></ItemsControl.ItemsPanel>
                                    <ItemsControl.ItemTemplate><DataTemplate>
                                        <Button Style="{StaticResource SecondaryButtonStyle}" Command="{Binding DataContext.SelectPeerCommand, RelativeSource={RelativeSource AncestorType=Window}}" CommandParameter="{Binding}" Margin="0,0,8,8" MinWidth="190" AutomationProperties.Name="Select nearby device">
                                            <StackPanel Orientation="Horizontal"><Path Data="{StaticResource IconLaptop}" Fill="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}" Width="20" Height="20" Stretch="Uniform" Margin="0,0,10,0" /><StackPanel><TextBlock Text="{Binding DeviceName}" Foreground="{DynamicResource TextPrimaryBrush}" FontWeight="SemiBold" MaxWidth="180" TextTrimming="CharacterEllipsis" ToolTip="{Binding DeviceName}" /><TextBlock Text="Invitation needed" Foreground="{DynamicResource TextSecondaryBrush}" FontSize="11" /></StackPanel></StackPanel>
                                        </Button>
                                    </DataTemplate></ItemsControl.ItemTemplate>
                                </ItemsControl>
                                <Button Style="{StaticResource SecondaryButtonStyle}" Content="Refresh nearby devices" Command="{Binding RefreshPeersCommand}" HorizontalAlignment="Left" Margin="0,6,0,0" />
                            </StackPanel>
                        </Border>
                        <Border Style="{StaticResource CardStyle}" Margin="0,16,0,0">
                            <StackPanel>
                                <TextBlock Text="Let a new device scan this PC" FontWeight="SemiBold" FontSize="16" />
                                <TextBlock Text="With files selected, show a one-time QR code. The other device scans it; you confirm the recipient before files are sent." Foreground="{DynamicResource TextSecondaryBrush}" FontSize="12" TextWrapping="Wrap" Margin="0,4,0,12" />
                                <Button Style="{StaticResource SecondaryButtonStyle}" Content="Show quick-share QR" Command="{Binding ShowQuickShareQrCommand}" IsEnabled="{Binding HasSelectedFiles}" HorizontalAlignment="Left" />
                            </StackPanel>
                        </Border>
                        <Button Style="{StaticResource SecondaryButtonStyle}" Content="Back to Send" Command="{Binding SwitchTabCommand}" CommandParameter="Send" HorizontalAlignment="Left" Margin="0,16,0,8" />
                    </StackPanel>
                </ScrollViewer>

                <!-- Receive -->
                <ScrollViewer x:Name="ReceivePage" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" Visibility="{Binding IsReceiveSelected, Converter={StaticResource BoolToVis}}">
                    <StackPanel>
                        <TextBlock Text="Make this PC available to nearby Glide devices. You approve each incoming transfer." Foreground="{DynamicResource TextSecondaryBrush}" Margin="0,0,0,20" TextWrapping="Wrap" />
                        <Border Style="{StaticResource CardStyle}">
                            <StackPanel>
                                <StackPanel>
                                    <TextBlock Text="{Binding ReceiveStatusTitle}" FontSize="18" FontWeight="SemiBold" />
                                    <TextBlock Text="Nearby devices can scan your one-time QR code. You will still review every offer." Foreground="{DynamicResource TextSecondaryBrush}" Margin="0,6,0,0" TextWrapping="Wrap" />
                                </StackPanel>
                                <Button x:Name="ReceiveControlButton" Style="{StaticResource PrimaryButtonStyle}" Content="{Binding ReceiveActionText}" Command="{Binding ToggleListenerCommand}" HorizontalAlignment="Left" Margin="0,14,0,0" />
                            </StackPanel>
                        </Border>
                        <Border Style="{StaticResource CardStyle}" Margin="0,16,0,0">
                            <StackPanel>
                                <TextBlock Text="Connect a phone" FontWeight="SemiBold" />
                                <TextBlock Text="Open Glide on the phone, choose Send files, then scan this code." Foreground="{DynamicResource TextSecondaryBrush}" FontSize="12" Margin="0,4,0,14" />
                                <StackPanel Orientation="Horizontal">
                                    <Border Background="White" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1" CornerRadius="10" Padding="10">
                                        <Image Source="{Binding PairingQrImage}" Width="180" Height="180" Stretch="Uniform" RenderOptions.BitmapScalingMode="NearestNeighbor" AutomationProperties.Name="QR code for receiving files" />
                                    </Border>
                                    <StackPanel Margin="20,4,0,0" VerticalAlignment="Center">
                                        <Button x:Name="ReceiveShowQrButton" Style="{StaticResource PrimaryButtonStyle}" Content="Show larger code" Command="{Binding ToggleQrZoomCommand}" Width="192" HorizontalAlignment="Left" Margin="0,0,0,8" />
                                        <Button x:Name="ReceiveCopyLinkButton" Style="{StaticResource SecondaryButtonStyle}" Content="Copy pairing link" Command="{Binding CopyPairingLinkCommand}" Width="192" HorizontalAlignment="Left" Margin="0,0,0,8" />
                                        <Button x:Name="ReceiveRefreshQrButton" Style="{StaticResource SecondaryButtonStyle}" Content="Refresh code" Command="{Binding RefreshQrCommand}" Width="192" HorizontalAlignment="Left" />
                                    </StackPanel>
                                </StackPanel>
                            </StackPanel>
                        </Border>
                        <Border Style="{StaticResource CardStyle}" Margin="0,16,0,0">
                            <StackPanel>
                                <TextBlock Text="Save received files to" FontWeight="SemiBold" />
                                <Grid Margin="0,10,0,0">
                                    <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                                    <TextBox Style="{StaticResource ModernTextBoxStyle}" Text="{Binding ReceiveDirectory}" IsReadOnly="True" AutomationProperties.Name="Receive folder" />
                                    <Button Grid.Column="1" Style="{StaticResource SecondaryButtonStyle}" Content="Change folder" Command="{Binding BrowseReceiveFolderCommand}" Margin="8,0,0,0" />
                                </Grid>
                            </StackPanel>
                        </Border>
                    </StackPanel>
                </ScrollViewer>

                <!-- Activity -->
                <ScrollViewer x:Name="ActivityPage" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" Visibility="{Binding IsActivitySelected, Converter={StaticResource BoolToVis}}">
                    <StackPanel>
                        <TextBlock Text="Current transfers and verified file history." Foreground="{DynamicResource TextSecondaryBrush}" Margin="0,0,0,20" />
                        <Border Style="{StaticResource CardStyle}">
                            <StackPanel>
                                <TextBlock Text="Current transfer" FontWeight="SemiBold" />
                                <TextBlock Text="No transfer in progress." Foreground="{DynamicResource TextSecondaryBrush}" Margin="0,8,0,0">
                                    <TextBlock.Style><Style TargetType="TextBlock"><Style.Triggers><DataTrigger Binding="{Binding IsTransferActive}" Value="True"><Setter Property="Visibility" Value="Collapsed" /></DataTrigger></Style.Triggers></Style></TextBlock.Style>
                                </TextBlock>
                                <Grid Margin="0,12,0,0" Visibility="{Binding IsTransferActive, Converter={StaticResource BoolToVis}}">
                                    <StackPanel>
                                        <TextBlock Text="{Binding TransferTitle}" FontWeight="SemiBold" />
                                        <TextBlock Text="{Binding CurrentFileName}" Foreground="{DynamicResource TextSecondaryBrush}" TextTrimming="CharacterEllipsis" Margin="0,3,0,0" />
                                    </StackPanel>
                                    <StackPanel HorizontalAlignment="Right" Orientation="Horizontal">
                                        <TextBlock Text="{Binding TransferredBytesText}" Foreground="{DynamicResource TextSecondaryBrush}" VerticalAlignment="Center" Margin="0,0,14,0" />
                                        <TextBlock Text="{Binding TransferRateText}" FontWeight="SemiBold" VerticalAlignment="Center" Margin="0,0,14,0" />
                                        <Button Style="{StaticResource SecondaryButtonStyle}" Content="Cancel" Command="{Binding CancelTransferCommand}" IsEnabled="{Binding IsTransferActive}" />
                                    </StackPanel>
                                </Grid>
                                <ProgressBar Style="{StaticResource ModernProgressBarStyle}" Value="{Binding TotalProgress}" Margin="0,14,0,0" Visibility="{Binding IsTransferActive, Converter={StaticResource BoolToVis}}" />
                            </StackPanel>
                        </Border>
                        <Border Style="{StaticResource CardStyle}" Margin="0,16,0,0">
                            <Grid>
                                <Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="*" /></Grid.RowDefinitions>
                                <StackPanel>
                                    <StackPanel><TextBlock Text="Verified history" FontWeight="SemiBold" /><TextBlock Text="Only completed, verified items are kept here." FontSize="12" Foreground="{DynamicResource TextSecondaryBrush}" Margin="0,3,0,0" TextWrapping="Wrap" /></StackPanel>
                                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Left" Margin="0,12,0,0">
                                        <StackPanel><TextBlock Text="Search history" Foreground="{DynamicResource TextSecondaryBrush}" FontSize="11" Margin="0,0,0,4" /><TextBox Style="{StaticResource ModernTextBoxStyle}" Width="190" Text="{Binding ActivitySearchText, UpdateSourceTrigger=PropertyChanged}" ToolTip="Search history" AutomationProperties.Name="Search transfer activity" /></StackPanel>
                                        <StackPanel Margin="8,0,0,0"><TextBlock Text="Show" Foreground="{DynamicResource TextSecondaryBrush}" FontSize="11" Margin="0,0,0,4" /><ComboBox Width="100" ItemsSource="{Binding ActivityFilterOptions}" SelectedItem="{Binding ActivityFilter}" AutomationProperties.Name="Filter transfer direction" /></StackPanel>
                                    </StackPanel>
                                </StackPanel>
                                <ListBox x:Name="ActivityHistoryList" Grid.Row="1" ItemsSource="{Binding ActivityItems}" BorderThickness="0" Background="Transparent" Margin="0,16,0,0" MaxHeight="320" HorizontalContentAlignment="Stretch" ScrollViewer.HorizontalScrollBarVisibility="Disabled" ScrollViewer.CanContentScroll="True" VirtualizingPanel.IsVirtualizing="True">
                                    <ListBox.ItemTemplate>
                                        <DataTemplate>
                                            <Grid Margin="0,7">
                                                <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="116" /><ColumnDefinition Width="116" /></Grid.ColumnDefinitions>
                                                <StackPanel><TextBlock Text="{Binding ItemName}" Foreground="{DynamicResource TextPrimaryBrush}" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" /><TextBlock Text="{Binding Direction}" Foreground="{DynamicResource TextSecondaryBrush}" FontSize="11" /></StackPanel>
                                                <StackPanel Grid.Column="1" Margin="6,0"><TextBlock Text="{Binding FormattedSize}" Foreground="{DynamicResource TextPrimaryBrush}" HorizontalAlignment="Right" /><TextBlock Text="{Binding FormattedTime}" Foreground="{DynamicResource TextSecondaryBrush}" HorizontalAlignment="Right" FontSize="11" /></StackPanel>
                                                <Button Grid.Column="2" Style="{StaticResource SecondaryButtonStyle}" Content="Open folder" Command="{Binding DataContext.OpenHistoryItemCommand, RelativeSource={RelativeSource AncestorType=Window}}" CommandParameter="{Binding}" Width="110" HorizontalAlignment="Right" VerticalAlignment="Center" />
                                            </Grid>
                                        </DataTemplate>
                                    </ListBox.ItemTemplate>
                                </ListBox>
                            </Grid>
                        </Border>
                    </StackPanel>
                </ScrollViewer>

                <!-- Settings -->
                <ScrollViewer x:Name="SettingsPage" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" Visibility="{Binding IsSettingsSelected, Converter={StaticResource BoolToVis}}">
                    <StackPanel>
                        <TextBlock Text="Control how Glide appears and receives files." Foreground="{DynamicResource TextSecondaryBrush}" Margin="0,0,0,20" />
                        <Border Style="{StaticResource CardStyle}">
                            <StackPanel><TextBlock Text="Appearance" FontWeight="SemiBold" /><TextBlock Text="Match Windows by default, or choose a theme for Glide." Foreground="{DynamicResource TextSecondaryBrush}" FontSize="12" Margin="0,4,0,12" /><ComboBox ItemsSource="{Binding AppearanceOptions}" SelectedItem="{Binding AppearanceMode}" Width="180" HorizontalAlignment="Left" AutomationProperties.Name="Appearance theme" /></StackPanel>
                        </Border>
                        <Border Style="{StaticResource CardStyle}" Margin="0,16,0,0">
                            <StackPanel><TextBlock Text="Receiving" FontWeight="SemiBold" /><TextBlock Text="Folder and connection details are kept here so sending stays simple." Foreground="{DynamicResource TextSecondaryBrush}" FontSize="12" Margin="0,4,0,12" />
                                <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions><TextBox Style="{StaticResource ModernTextBoxStyle}" Text="{Binding ReceiveDirectory}" IsReadOnly="True" /><Button Grid.Column="1" Style="{StaticResource SecondaryButtonStyle}" Content="Change folder" Command="{Binding BrowseReceiveFolderCommand}" Margin="8,0,0,0" /></Grid>
                                <Expander Header="Advanced connection details" Margin="0,16,0,0"><StackPanel Margin="0,10,0,0"><TextBlock Text="{Binding LocalIpText, StringFormat=Local address: {0}}" Foreground="{DynamicResource TextSecondaryBrush}" /><TextBlock Text="{Binding ListeningPort, StringFormat=Listening port: {0}}" Foreground="{DynamicResource TextSecondaryBrush}" Margin="0,5,0,0" /><TextBlock Text="{Binding LocalIdentityFingerprint, StringFormat=Device fingerprint: {0}}" TextWrapping="Wrap" Foreground="{DynamicResource TextSecondaryBrush}" Margin="0,5,0,0" /></StackPanel></Expander>
                            </StackPanel>
                        </Border>
                        <Border Style="{StaticResource CardStyle}" Margin="0,16,0,0">
                            <StackPanel><TextBlock Text="Trusted devices" FontWeight="SemiBold" /><TextBlock Text="{Binding TrustedDevicesSummary}" Foreground="{DynamicResource TextSecondaryBrush}" FontSize="12" Margin="0,4,0,12" />
                                <ItemsControl ItemsSource="{Binding TrustedDevices}"><ItemsControl.ItemTemplate><DataTemplate><Grid Margin="0,5"><Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions><StackPanel><TextBlock Text="{Binding DisplayName}" FontWeight="SemiBold" /><TextBlock Text="{Binding FingerprintShort}" Foreground="{DynamicResource TextSecondaryBrush}" FontFamily="Consolas" FontSize="11" /><TextBlock Text="{Binding LastSeenText}" Foreground="{DynamicResource TextSecondaryBrush}" FontSize="11" /></StackPanel><Button Grid.Column="1" Style="{StaticResource SecondaryButtonStyle}" Content="Remove" Command="{Binding DataContext.RevokeTrustedDeviceCommand, RelativeSource={RelativeSource AncestorType=Window}}" CommandParameter="{Binding}" VerticalAlignment="Center" /></Grid></DataTemplate></ItemsControl.ItemTemplate></ItemsControl>
                            </StackPanel>
                        </Border>
                    </StackPanel>
                </ScrollViewer>
            </Grid>

            <Border Grid.Row="2" Margin="0,16,0,0" Background="{DynamicResource SurfaceRaisedBrush}" CornerRadius="8" Padding="12" Visibility="{Binding IsTransferActive, Converter={StaticResource BoolToVis}}">
                <Grid><TextBlock Text="{Binding TransferTitle}" FontWeight="SemiBold" /><TextBlock HorizontalAlignment="Right" Text="{Binding TransferredBytesText}" Foreground="{DynamicResource TextSecondaryBrush}" /></Grid>
            </Border>
        </Grid>

        <!-- Saved device picker -->
        <Border Grid.ColumnSpan="2" Background="#99000000" Visibility="{Binding IsTrustedDevicePickerVisible, Converter={StaticResource BoolToVis}}" Panel.ZIndex="11" IsVisibleChanged="TrustedPicker_IsVisibleChanged">
            <Border Style="{StaticResource CardStyle}" Width="480" HorizontalAlignment="Center" VerticalAlignment="Center" Padding="28" KeyboardNavigation.TabNavigation="Cycle">
                <StackPanel>
                    <TextBlock Text="Choose a saved device" FontSize="20" FontWeight="SemiBold" />
                    <TextBlock Text="{Binding TrustedDevicesSummary}" Foreground="{DynamicResource TextSecondaryBrush}" TextWrapping="Wrap" Margin="0,6,0,16" />
                    <ScrollViewer MaxHeight="260" VerticalScrollBarVisibility="Auto">
                        <ItemsControl ItemsSource="{Binding TrustedDevices}">
                            <ItemsControl.ItemTemplate><DataTemplate>
                                <Button Style="{StaticResource SecondaryButtonStyle}" Command="{Binding DataContext.SelectTrustedDeviceCommand, RelativeSource={RelativeSource AncestorType=Window}}" CommandParameter="{Binding}" HorizontalContentAlignment="Stretch" Margin="0,0,0,8" AutomationProperties.Name="Select saved device">
                                    <Grid Width="390"><Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions><StackPanel><TextBlock Text="{Binding DisplayName}" Foreground="{DynamicResource TextPrimaryBrush}" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" ToolTip="{Binding DisplayName}" /><TextBlock Text="{Binding LastSeenText}" Foreground="{DynamicResource TextSecondaryBrush}" FontSize="11" /></StackPanel><TextBlock Grid.Column="1" Text="Select" Foreground="{DynamicResource PrimaryBrush}" VerticalAlignment="Center" /></Grid>
                                </Button>
                            </DataTemplate></ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </ScrollViewer>
                    <TextBlock Text="A fresh invitation is required for each send. Glide checks the saved identity before transfer." Foreground="{DynamicResource TextSecondaryBrush}" FontSize="12" TextWrapping="Wrap" Margin="0,8,0,16" />
                    <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions><Button Grid.Column="0" Style="{StaticResource SecondaryButtonStyle}" Content="Pair a new device" Command="{Binding ShowPairModalCommand}" HorizontalAlignment="Left" /><Button x:Name="CloseTrustedDevicePickerButton" Grid.Column="1" Style="{StaticResource SecondaryButtonStyle}" Content="Close" Command="{Binding CloseTrustedDevicePickerCommand}" /></Grid>
                </StackPanel>
            </Border>
        </Border>

        <!-- Receiving consent -->
        <Border Grid.ColumnSpan="2" Background="#99000000" Visibility="{Binding IsOfferModalVisible, Converter={StaticResource BoolToVis}}" Panel.ZIndex="10">
            <Border Style="{StaticResource CardStyle}" Width="470" HorizontalAlignment="Center" VerticalAlignment="Center" Padding="28" KeyboardNavigation.TabNavigation="Cycle">
                <StackPanel><TextBlock Text="Incoming transfer" FontSize="20" FontWeight="SemiBold" HorizontalAlignment="Center" /><TextBlock Text="{Binding IncomingOfferPeer}" FontWeight="SemiBold" HorizontalAlignment="Center" Margin="0,10,0,4" /><TextBlock Text="{Binding IncomingOfferSummary}" TextAlignment="Center" Foreground="{DynamicResource TextSecondaryBrush}" TextWrapping="Wrap" /><TextBlock Text="Review the sender and file summary. Accepted files are written to your selected receive folder." TextAlignment="Center" Foreground="{DynamicResource TextSecondaryBrush}" FontSize="12" TextWrapping="Wrap" Margin="0,12,0,20" /><Grid><Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="12" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions><Button Grid.Column="0" Style="{StaticResource SecondaryButtonStyle}" Content="Decline" Command="{Binding RejectOfferCommand}" /><Button Grid.Column="2" Style="{StaticResource PrimaryButtonStyle}" Content="Accept transfer" Command="{Binding AcceptOfferCommand}" /></Grid></StackPanel>
            </Border>
        </Border>

        <!-- Trust consent -->
        <Border Grid.ColumnSpan="2" Background="#99000000" Visibility="{Binding IsTrustEnrollmentModalVisible, Converter={StaticResource BoolToVis}}" Panel.ZIndex="102">
            <Border Style="{StaticResource CardStyle}" Width="510" HorizontalAlignment="Center" VerticalAlignment="Center" Padding="28" KeyboardNavigation.TabNavigation="Cycle">
                <StackPanel><TextBlock Text="Trust this device?" FontSize="20" FontWeight="SemiBold" HorizontalAlignment="Center" /><TextBlock Text="{Binding TrustEnrollmentPeerName}" FontWeight="SemiBold" HorizontalAlignment="Center" Margin="0,10,0,8" /><TextBlock Text="Glide verified this device for the current session. Compare the full fingerprint before letting Glide recognise it in future sessions." TextAlignment="Center" Foreground="{DynamicResource TextSecondaryBrush}" TextWrapping="Wrap" /><Border Background="{DynamicResource SurfaceRaisedBrush}" CornerRadius="8" Padding="12" Margin="0,16"><TextBlock Text="{Binding TrustEnrollmentFingerprint}" FontFamily="Consolas" TextAlignment="Center" TextWrapping="Wrap" /></Border><Grid><Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="12" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions><Button Grid.Column="0" Style="{StaticResource SecondaryButtonStyle}" Content="Not Now" Command="{Binding RejectTrustEnrollmentCommand}" /><Button Grid.Column="2" Style="{StaticResource PrimaryButtonStyle}" Content="Trust Device" Command="{Binding AcceptTrustEnrollmentCommand}" /></Grid></StackPanel>
            </Border>
        </Border>

        <!-- Recipient confirmation -->
        <Border Grid.ColumnSpan="2" Background="#99000000" Visibility="{Binding IsRecipientConfirmationModalVisible, Converter={StaticResource BoolToVis}}" Panel.ZIndex="103">
            <Border Style="{StaticResource CardStyle}" Width="460" HorizontalAlignment="Center" VerticalAlignment="Center" Padding="28" KeyboardNavigation.TabNavigation="Cycle">
                <StackPanel><TextBlock Text="Confirm receiving device" FontSize="20" FontWeight="SemiBold" HorizontalAlignment="Center" /><TextBlock Text="{Binding RecipientConfirmationPeerName}" FontWeight="SemiBold" HorizontalAlignment="Center" Margin="0,10,0,8" /><TextBlock Text="This device scanned your one-time code. Confirm it before Glide reveals the selected files or starts transfer." TextAlignment="Center" Foreground="{DynamicResource TextSecondaryBrush}" TextWrapping="Wrap" Margin="0,0,0,20" /><Grid><Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="12" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions><Button Grid.Column="0" Style="{StaticResource SecondaryButtonStyle}" Content="Reject" Command="{Binding RejectRecipientCommand}" /><Button Grid.Column="2" Style="{StaticResource PrimaryButtonStyle}" Content="Send files" Command="{Binding AcceptRecipientCommand}" /></Grid></StackPanel>
            </Border>
        </Border>

        <!-- Pairing -->
        <Border Grid.ColumnSpan="2" Background="#99000000" Visibility="{Binding IsPairModalVisible, Converter={StaticResource BoolToVis}}" Panel.ZIndex="13">
            <Border Style="{StaticResource CardStyle}" Width="500" HorizontalAlignment="Center" VerticalAlignment="Center" Padding="28" KeyboardNavigation.TabNavigation="Cycle">
                <StackPanel><TextBlock Text="{Binding PairingSheetTitle}" FontSize="20" FontWeight="SemiBold" HorizontalAlignment="Center" /><TextBlock Text="{Binding PairingSheetInstruction}" Foreground="{DynamicResource TextSecondaryBrush}" TextAlignment="Center" TextWrapping="Wrap" Margin="0,10,0,18" />
                    <StackPanel Visibility="{Binding IsHostedSendQrVisible, Converter={StaticResource BoolToVis}}" HorizontalAlignment="Center"><Border Background="White" CornerRadius="10" Padding="12"><Image Source="{Binding PairingQrImage}" Width="260" Height="260" Stretch="Uniform" RenderOptions.BitmapScalingMode="NearestNeighbor" AutomationProperties.Name="QR code for receiving selected files" /></Border><TextBlock Text="This code expires automatically for your security." Foreground="{DynamicResource TextSecondaryBrush}" FontSize="12" HorizontalAlignment="Center" Margin="0,10,0,0" /><Button Style="{StaticResource SecondaryButtonStyle}" Content="Refresh code" Command="{Binding RefreshQrCommand}" Margin="0,12,0,0" /></StackPanel>
                    <Button Style="{StaticResource SecondaryButtonStyle}" Content="Cancel quick share" Command="{Binding CancelPairModalCommand}" HorizontalAlignment="Center" Margin="0,20,0,0" />
                </StackPanel>
            </Border>
        </Border>

        <Border Grid.ColumnSpan="2" Background="#CC000000" Visibility="{Binding IsQrZoomModalVisible, Converter={StaticResource BoolToVis}}" Panel.ZIndex="14">
            <Border Style="{StaticResource CardStyle}" HorizontalAlignment="Center" VerticalAlignment="Center" Padding="28" KeyboardNavigation.TabNavigation="Cycle">
                <StackPanel><TextBlock Text="Scan with Glide Mobile" FontSize="20" FontWeight="SemiBold" HorizontalAlignment="Center" Margin="0,0,0,16" /><Border Background="White" CornerRadius="12" Padding="16"><Image Source="{Binding PairingQrImage}" Width="400" Height="400" Stretch="Uniform" RenderOptions.BitmapScalingMode="NearestNeighbor" /></Border><StackPanel Orientation="Horizontal" HorizontalAlignment="Center" Margin="0,18,0,0"><Button Style="{StaticResource SecondaryButtonStyle}" Content="Refresh" Command="{Binding RefreshQrCommand}" Margin="0,0,8,0" /><Button Style="{StaticResource SecondaryButtonStyle}" Content="Copy link" Command="{Binding CopyPairingLinkCommand}" Margin="0,0,8,0" /><Button Style="{StaticResource PrimaryButtonStyle}" Content="Close" Command="{Binding ToggleQrZoomCommand}" /></StackPanel></StackPanel>
            </Border>
        </Border>
    </Grid>
</Window>
