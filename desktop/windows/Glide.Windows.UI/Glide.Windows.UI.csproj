<Project Sdk="Microsoft.NET.Sdk">

  <ItemGroup>
    <ProjectReference Include="..\..\src\Glide.Core\Glide.Core.csproj" />
    <ProjectReference Include="..\..\src\Glide.Transport\Glide.Transport.csproj" />
    <ProjectReference Include="..\..\src\Glide.Desktop\Glide.Desktop.csproj" />
    <ProjectReference Include="..\..\src\Glide.App\Glide.App.csproj" />
  </ItemGroup>

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <AssemblyName>Glide</AssemblyName>
    <TargetFramework>net10.0-windows</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <UseWPF>true</UseWPF>
    <ApplicationIcon>glide.ico</ApplicationIcon>
    <DebugType>none</DebugType>
    <DebugSymbols>false</DebugSymbols>
    <IncludeSourceRevisionInInformationalVersion>false</IncludeSourceRevisionInInformationalVersion>
    <GlideUpdateFeedUrl Condition="'$(GlideUpdateFeedUrl)' == ''"></GlideUpdateFeedUrl>
    <GlideUpdatePublicKey Condition="'$(GlideUpdatePublicKey)' == ''"></GlideUpdatePublicKey>
  </PropertyGroup>

  <ItemGroup>
    <Resource Include="glide.ico" />
    <Resource Include="..\..\..\assets\wordmarks\glide-wordmark-indigo-512.png" Link="Assets\glide-wordmark-indigo-512.png" />
    <AssemblyMetadata Include="GlideUpdateFeedUrl" Value="$(GlideUpdateFeedUrl)" />
    <AssemblyMetadata Include="GlideUpdatePublicKey" Value="$(GlideUpdatePublicKey)" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="NetSparkleUpdater.UI.WPF" Version="3.1.0" />
  </ItemGroup>

</Project>
