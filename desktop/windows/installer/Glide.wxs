<!--
  Glide Windows Installer (WiX Toolset v5)
  Defines per-machine MSI installer package for Microsoft Store and Enterprise deployment.
  Maintained alongside desktop/windows/installer/Glide.nsi.
-->
<Wix xmlns="http://wixtoolset.org/schemas/v4/wxs">
  <Package Name="Glide"
           Manufacturer="Glide"
           Version="$(var.Version)"
           UpgradeCode="88597E1C-6246-4A51-B833-311D79E78C20"
           Scope="perMachine">

    <SummaryInformation Description="Glide Peer-to-Peer File Transfer" Manufacturer="Glide" />
    <MediaTemplate EmbedCab="yes" />

    <!-- Major Upgrade Rule: cleanly uninstalls prior versions on upgrade -->
    <MajorUpgrade DowngradeErrorMessage="A newer version of Glide is already installed."
                  AllowSameVersionUpgrades="no"
                  Schedule="afterInstallExecute" />

    <!-- Standard Windows Directory Layout -->
    <StandardDirectory Id="ProgramFiles64Folder">
      <Directory Id="INSTALLFOLDER" Name="Glide" />
    </StandardDirectory>

    <StandardDirectory Id="ProgramMenuFolder">
      <Directory Id="ApplicationProgramsFolder" Name="Glide" />
    </StandardDirectory>

    <StandardDirectory Id="DesktopFolder" />

    <!-- Application Payload Files: Native WiX v5 Directory Harvesting -->
    <ComponentGroup Id="AppFiles">
      <Files Directory="INSTALLFOLDER" Include="$(var.StageDir)\**" />
    </ComponentGroup>

    <!-- Shortcuts, Protocol Handlers, and Application Registry -->
    <ComponentGroup Id="AppShortcuts">
      <Component Id="StartMenuShortcutComponent" Directory="ApplicationProgramsFolder" Guid="A2B3C4D5-E6F7-4A2B-8C3D-3E5F6A7B8C9D">
        <Shortcut Id="ApplicationStartMenuShortcut"
                  Name="Glide"
                  Description="Glide Local File Sharing"
                  Target="[INSTALLFOLDER]Glide.exe"
                  WorkingDirectory="INSTALLFOLDER"
                  Icon="AppIcon" />
        <RemoveFolder Id="CleanUpProgramMenuFolder" Directory="ApplicationProgramsFolder" On="uninstall" />
        <RegistryValue Root="HKCU" Key="Software\Glide\Shortcuts" Name="StartMenu" Type="integer" Value="1" KeyPath="yes" />
      </Component>

      <Component Id="DesktopShortcutComponent" Directory="DesktopFolder" Guid="B3C4D5E6-F7A2-4B3C-9D4E-4F6A7B8C9D0E">
        <Shortcut Id="ApplicationDesktopShortcut"
                  Name="Glide"
                  Description="Glide Local File Sharing"
                  Target="[INSTALLFOLDER]Glide.exe"
                  WorkingDirectory="INSTALLFOLDER"
                  Icon="AppIcon" />
        <RegistryValue Root="HKCU" Key="Software\Glide\Shortcuts" Name="Desktop" Type="integer" Value="1" KeyPath="yes" />
      </Component>

      <Component Id="ProtocolRegistrationComponent" Directory="INSTALLFOLDER" Guid="D5E6F7A2-B3C4-4D5E-BF6A-6B7C8D9E0F2B">
        <!-- Native URL protocol handler for glide://pair/v1#... links -->
        <RegistryKey Root="HKCR" Key="glide">
          <RegistryValue Type="string" Value="URL:Glide Protocol" />
          <RegistryValue Name="URL Protocol" Type="string" Value="" />
          <RegistryKey Key="shell\open\command">
            <RegistryValue Type="string" Value="&quot;[INSTALLFOLDER]Glide.exe&quot; &quot;%1&quot;" />
          </RegistryKey>
        </RegistryKey>

        <!-- Application metadata -->
        <RegistryKey Root="HKMU" Key="Software\Glide">
          <RegistryValue Name="InstallPath" Type="string" Value="[INSTALLFOLDER]" />
          <RegistryValue Name="Version" Type="string" Value="$(var.Version)" />
        </RegistryKey>
        <RegistryValue Root="HKMU" Key="Software\Glide" Name="Installed" Type="integer" Value="1" KeyPath="yes" />
      </Component>
    </ComponentGroup>

    <!-- Add/Remove Programs (ARP) Metadata -->
    <Icon Id="AppIcon" SourceFile="$(var.StageDir)\glide.ico" />
    <Property Id="ARPPRODUCTICON" Value="AppIcon" />
    <Property Id="ARPNOREPAIR" Value="1" />
    <Property Id="ARPNOMODIFY" Value="1" />
    <Property Id="ARPHELPLINK" Value="https://github.com/GDJ2001/Glide" />
    <Property Id="ARPURLINFOABOUT" Value="https://github.com/GDJ2001/Glide" />

    <!-- Root Feature -->
    <Feature Id="MainFeature" Title="Glide Application" Level="1">
      <ComponentGroupRef Id="AppFiles" />
      <ComponentGroupRef Id="AppShortcuts" />
    </Feature>
  </Package>
</Wix>
